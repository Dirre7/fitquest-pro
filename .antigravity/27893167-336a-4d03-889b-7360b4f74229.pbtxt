    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import {\n  UserProfile,\n  WorkoutRoutine,\n  CommunityChallenge,\n  Achievement,\n  LeaderboardUser,\n  SmartwatchDevice,\n  PushReminder,\n  WorkoutHistoryEntry,\n} from \'../types\';\n\n/**\n * Creates a clean brand-new user profile with 0 stats, 0 XP, Level 1.\n */\nexport const createFreshUser = (id: string, name: string, email?: string): UserProfile => {\n  const initial = name.trim() ? name.trim().charAt(0).toUpperCase() : \'U\';\n  return {\n    id,\n    name: name || (email ? email.split(\'@\')[0] : \'Atleta FitQuest\'),\n    avatar: `https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(name || id)}&backgroundColor=06b6d4,3b82f6`,\n    level: 1,\n    xp: 0,\n    currentLevelXp: 0,\n    nextLevelXp: 250,\n    rankTitle: \'Recluta Inicial\',\n    league: \'Bronze\',\n    leaguePoints: 0,\n    stats: {\n      totalWorkouts: 0,\n      totalVolumeKg: 0,\n      totalMinutes: 0,\n      caloriesBurned: 0,\n      currentStreak: 0,\n      bestStreak: 0,\n      duelsWon: 0,\n      challengesCompleted: 0,\n    },\n    attributes: {\n      strength: 10,\n      endurance: 10,\n      agility: 10,\n      discipline: 10,\n    },\n    unlockedBadges: [],\n    joinedAt: new Date().toISOString().split(\'T\')[0],\n    weightKg: 70.0,\n    targetWeightKg: 70.0,\n  };\n};\n\n/**\n * Clean fresh achievement list starting with 0 progress for new users.\n */\nexport const createFreshAchievements = (): Achievement[] => [\n  {\n    id: \'ach_first_workout\',\n    title: \'Primer Paso de Leyenda\',\n    description: \'Completa tu primer entrenamiento en la plataforma.\',\n    icon: \'Flame\',\n    category: \'consistency\',\n    tier: \'Bronze\',\n    currentProgress: 0,\n    maxProgress: 1,\n    unlocked: false,\n    xpReward: 100,\n    rewardTitle: \'Iniciado\',\n  },\n  {\n    id: \'ach_first_pr\',\n    title: \'Superando L\303\255mites\',\n    description: \'Establece tu primer r\303\251cord personal (PR) en cualquier ejercicio.\',\n    icon: \'Trophy\',\n    category: \'strength\',\n    tier: \'Bronze\',\n    currentProgress: 0,\n    maxProgress: 1,\n    unlocked: false,\n    xpReward: 150,\n    rewardTitle: \'Rompedor de Marcas\',\n  },\n  {\n    id: \'ach_streak_3\',\n    title: \'Racha de Bronce\',\n    description: \'Entrena 3 d\303\255as consecutivos sin romper la racha.\',\n    icon: \'Flame\',\n    category: \'consistency\',\n    tier: \'Bronze\',\n    currentProgress: 0,\n    maxProgress: 3,\n    unlocked: false,\n    xpReward: 200,\n    rewardTitle: \'Persistente\',\n  },\n  {\n    id: \'ach_streak_7\',\n    title: \'Semana de Hierro\',\n    description: \'Mant\303\251n una racha de 7 d\303\255as consecutivos de entrenamiento.\',\n    icon: \'Flame\',\n    category: \'consistency\',\n    tier: \'Silver\',\n    currentProgress: 0,\n    maxProgress: 7,\n    unlocked: false,\n    xpReward: 300,\n    rewardTitle: \'Constante\',\n  },\n  {\n    id: \'ach_streak_30\',\n    title: \'Disciplina Absoluta\',\n    description: \'Mant\303\251n una racha activa de 30 d\303\255as consecutivos.\',\n    icon: \'Zap\',\n    category: \'consistency\',\n    tier: \'Titan\',\n    currentProgress: 0,\n    maxProgress: 30,\n    unlocked: false,\n    xpReward: 1200,\n    rewardTitle: \'Inquebrantable\',\n  },\n  {\n    id: \'ach_duel_master\',\n    title: \'Gladiador de la Arena\',\n    description: \'Gana 10 duelos de entrenamiento social en vivo.\',\n    icon: \'Swords\',\n    category: \'social\',\n    tier: \'Gold\',\n    currentProgress: 0,\n    maxProgress: 10,\n    unlocked: false,\n    xpReward: 600,\n    rewardTitle: \'Camp\303\251on de Duelo\',\n  },\n  {\n    id: \'ach_tonnage_10k\',\n    title: \'Levantador de Monta\303\261as\',\n    description: \'Acumula m\303\241s de 10,000 kg de volumen total levantado en tu historial.\',\n    icon: \'Shield\',\n    category: \'strength\',\n    tier: \'Silver\',\n    currentProgress: 0,\n    maxProgress: 10000,\n    unlocked: false,\n    xpReward: 500,\n    rewardTitle: \'Coloso de Acero\',\n  },\n  {\n    id: \'ach_smartwatch_sync\',\n    title: \'Atleta Cibern\303\251tico\',\n    description: \'Sincroniza un smartwatch y completa 5 entrenamientos con monitoreo card\303\255aco en vivo.\',\n    icon: \'Watch\',\n    category: \'speed\',\n    tier: \'Silver\',\n    currentProgress: 0,\n    maxProgress: 5,\n    unlocked: false,\n    xpReward: 350,\n    rewardTitle: \'Bio-Sincronizado\',\n  },\n  {\n    id: \'ach_community_hero\',\n    title: \'Pilar Comunitario\',\n    description: \'Completa con \303\251xito 3 retos comunitarios semanales.\',\n    icon: \'Crown\',\n    category: \'social\',\n    tier: \'Titan\',\n    currentProgress: 0,\n    maxProgress: 3,\n    unlocked: false,\n    xpReward: 800,\n    rewardTitle: \'H\303\251roe Comunitario\',\n  },\n];\n\nexport const defaultRoutines: WorkoutRoutine[] = [\n  {\n    id: \'rt_upper_strength\',\n    title: \'Torso Fuerza & Sobrecarga\',\n    description: \'Rutina de fuerza enfocada en banca, remo con barra y press militar con descansos controlados.\',\n    category: \'Strength\',\n    difficulty: \'Intermediate\',\n    durationMinutes: 50,\n    estimatedCalories: 450,\n    xpReward: 300,\n    targetMuscles: [\'Pectoral\', \'Espalda\', \'Hombros\', \'Tr\303\255ceps\'],\n    tags: [\'Fuerza\', \'Barra\', \'Sobrecarga\'],\n    exercises: [\n      {\n        id: \'ex_bench_press\',\n        name: \'Press de Banca Plano\',\n        muscleGroup: \'Chest\',\n        equipment: \'Barbell\',\n        restSeconds: 90,\n        prKg: 0,\n        instructions: \'Apoya bien los pies, retrae esc\303\241pulas y baja la barra al estern\303\263n con control.\',\n        tip: \'Mant\303\251n los codos en \303\241ngulo de 45\302\260 a 75\302\260 con respecto al torso.\',\n        sets: [\n          { id: \'s1\', setNumber: 1, targetReps: 12, actualReps: 12, targetWeightKg: 40, actualWeightKg: 40, completed: false, isWarmup: true },\n          { id: \'s2\', setNumber: 2, targetReps: 10, actualR