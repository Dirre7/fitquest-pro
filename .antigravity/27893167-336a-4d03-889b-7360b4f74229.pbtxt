    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Flame,\n  Zap,\n  Dumbbell,\n  Trophy,\n  Swords,\n  Activity,\n  Heart,\n  TrendingUp,\n  Award,\n  ChevronRight,\n  Shield,\n  Clock,\n  Sparkles,\n  Target,\n  Watch,\n  Users,\n} from \'lucide-react\';\nimport {\n  UserProfile,\n  WorkoutRoutine,\n  CommunityChallenge,\n  SmartwatchDevice,\n  Language,\n} from \'../types\';\nimport { translations } from \'../lib/i18n\';\n\ninterface DashboardViewProps {\n  user: UserProfile;\n  routines: WorkoutRoutine[];\n  challenges: CommunityChallenge[];\n  smartwatch: SmartwatchDevice;\n  lang: Language;\n  onStartRoutine: (routine: WorkoutRoutine) => void;\n  onNavigateTab: (tab: string) => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  user,\n  routines,\n  challenges,\n  smartwatch,\n  lang,\n  onStartRoutine,\n  onNavigateTab,\n}) => {\n  const t = translations[lang];\n\n  const activeChallenge = challenges[0];\n  const xpPercent = Math.min(100, Math.round((user.currentLevelXp / user.nextLevelXp) * 100));\n\n  return (\n    <div className=\"space-y-6 animate-in fade-in duration-300\">\n      \n      {/* Top Hero Banner: Gamification Level, Rank & Streak */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-4\">\n        \n        {/* Main Hero Card */}\n        <div className=\"lg:col-span-8 bg-gradient-to-br from-neutral-900 via-neutral-900 to-neutral-950 border border-neutral-800 rounded-3xl p-5 sm:p-7 relative overflow-hidden shadow-2xl\">\n          {/* Subtle background glow */}\n          <div className=\"absolute -right-10 -bottom-10 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none\" />\n          <div className=\"absolute -left-10 -top-10 w-60 h-60 bg-teal-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n          <div className=\"relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5\">\n            {/* Avatar & User Info */}\n            <div className=\"flex items-center gap-4\">\n              <div className=\"relative\">\n                <img\n                  src={user.avatar}\n                  alt={user.name}\n                  className=\"w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-2 border-emerald-500/50 shadow-xl shadow-emerald-500/20\"\n                />\n                <div className=\"absolute -bottom-2 -right-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-black text-xs font-black px-2 py-0.5 rounded-lg shadow\">\n                  Nv. {user.level}\n                </div>\n              </div>\n\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h1 className=\"font-display font-extrabold text-2xl sm:text-3xl text-white tracking-tight\">\n                    {user.name}\n                  </h1>\n                  <span className=\"text-xs font-black px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30\">\n                    Liga {user.league}\n                  </span>\n                </div>\n                <p className=\"text-xs sm:text-sm font-semibold text-emerald-400 mt-0.5 flex items-center gap-1.5\">\n                  <Shield className=\"w-3.5 h-3.5\" />\n                  {user.rankTitle}\n                </p>\n                <p className=\"text-xs text-neutral-400 mt-1\">\n                  {user.stats.totalWorkouts} sesiones completadas \342\200\242 {Math.round(user.stats.totalVolumeKg / 1000)}t levantadas\n                </p>\n              </div>\n            </div>\n\n            {/* Quick Action Button */}\n            <button\n              id=\"btn-dash-quick-workout\"\n              onClick={() => onStartRoutine(routines[0])}\n              className=\"w-full sm:w-auto px-5 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-neutral-950 font-extrabold text-sm shadow-xl shadow-emerald-500/25 flex items-center justify-center gap-2 transition-all hover:scale-105 active:scale-95\"\n            >\n              <Zap className=\"w-4 h-4 fill-current\" />\n              <span>{t.quickStart}</span>\n            </button>\n          </div>\n\n          {/* Level Progress Bar & Attributes */}\n          <div className=\"mt-6 pt-5 border-t border-neutral-800/80\">\n            <div className=\"flex justify-between items-center text-xs font-bold mb-2\">\n              <span className=\"text-neutral-300 flex items-center gap-1.5\">\n                <Sparkles className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>Nivel {user.level} \342\206\222 Nivel {user.level + 1}</span>\n              </span>\n              <span className=\"text-emerald-400 font-mono\">\n                {user.currentLevelXp} / {user.nextLevelXp} XP ({xpPercent}%)\n              </span>\n            </div>\n            <div className=\"h-2.5 bg-neutral-800 rounded-full overflow-hidden p-0.5 border border-neutral-700/60\">\n              <div\n                className=\"h-full bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-400 rounded-full transition-all duration-700 shadow-sm shadow-emerald-400/50\"\n                style={{ width: `${xpPercent}%` }}\n              />\n            </div>\n\n            {/* RPG Character Attribute Bars */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4\">\n              <div className=\"bg-neutral-800/60 p-2.5 rounded-xl border border-neutral-700/60\">\n                <div className=\"flex justify-between text-[11px] font-bold text-neutral-300\">\n                  <span>Fuerza</span>\n                  <span className=\"text-red-400 font-mono\">{user.attributes.strength}/100</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-700 rounded-full mt-1.5 overflow-hidden\">\n                  <div className=\"h-full bg-red-500 rounded-full\" style={{ width: `${user.attributes.strength}%` }} />\n                </div>\n              </div>\n\n              <div className=\"bg-neutral-800/60 p-2.5 rounded-xl border border-neutral-700/60\">\n                <div className=\"flex justify-between text-[11px] font-bold text-neutral-300\">\n                  <span>Resistencia</span>\n                  <span className=\"text-cyan-400 font-mono\">{user.attributes.endurance}/100</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-700 rounded-full mt-1.5 overflow-hidden\">\n                  <div className=\"h-full bg-cyan-500 rounded-full\" style={{ width: `${user.attributes.endurance}%` }} />\n                </div>\n              </div>\n\n              <div className=\"bg-neutral-800/60 p-2.5 rounded-xl border border-neutral-700/60\">\n                <div className=\"flex justify-between text-[11px] font-bold text-neutral-300\">\n                  <span>Agilidad</span>\n                  <span className=\"text-amber-400 font-mono\">{user.attributes.agility}/100</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-700 rounded-full mt-1.5 overflow-hidden\">\n                  <div className=\"h-full bg-amber-500 rounded-full\" style={{ width: `${user.attributes.agility}%` }} />\n                </div>\n              </div>\n\n              <div className=\"bg-neutral-800/60 p-2.5 rounded-xl border border-neutral-700/60\">\n                <div className=\"flex justify-between text-[11px] font-bold text-neutral-300\">\n                  <span>Disciplina</span>\n                  <span className=\"text-emerald-400 font-mono\">{user.attributes.discipline}/100</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-700 rounded-full mt-1.5 overflow-hidden\">\n                  <div className=\"h-full bg-emerald-500 rounded-full\" style={{ width: `${user.attributes.discipline}%` }} />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Daily Streak & Biometrics Widget */}\n        <div className=\"lg:col-span-4 flex flex-col gap-4\">\n          \n          {/* Daily Streak Card */}\n          <div className=\"bg-gradient-to-br from-amber-950/40 via-neutral-900 to-neutral-900 border border-amber-500/30 rounded-3xl p-5 shadow-xl flex items-center justify-between\">\n            <div className=\"flex items-center gap-3.5\">\n              <div className=\"w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-500 shadow-lg shadow-amber-500/20\">\n                <Flame className=\"w-6 h-6 animate-bounce\" />\n              </div>\n              <div>\n                <span className=\"text-[11px] font-extrabold uppercase text-amber-400 tracking-wider\">\n                  {t.currentStreak}\n                </span>\n                <h3 className=\"font-display font-extrabold text-2xl text-white\">\n                  {user.stats.currentStreak} {t.streakDays}\n                </h3>\n                <p className=\"text-[11px] text-neutral-400\">R\303\251cord personal: {user.stats.bestStreak} d\303\255as</p>\n              </div>\n            </div>\n            <div className=\"text-right\">\n              <span className=\"text-xs font-bold px-2.5 py-1 rounded-xl bg-amber-500 text-black shadow-md\">\n                +15% XP Boost\n              </span>\n            </div>\n          </div>\n\n          {/* Live Smartwatch Biometrics Card */}\n          <div className=\"bg-neutral-900 border border-neutral-800 rounded-3xl p-5 shadow-xl flex-1 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <Watch className=\"w-4 h-4 text-emerald-400\" />\n                <span className=\"text-xs font-bold text-neutral-300\">{smartwatch.name}</span>\n              </div>\n              <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">\n                {smartwatch.status === \'connected\' ? \'En Vivo\' : \'Desconectado\'}\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3 my-3\">\n              <div className=\"bg-neutral-800/60 p-3 rounded-2xl border border-neutral-700/60\">\n                <div className=\"flex items-center gap-1.5 text-red-400 text-xs font-bold mb-1\">\n                  <Heart className=\"w-3.5 h-3.5 fill-current animate-heart-beat\" />\n                  <span>Pulsaciones</span>\n                </div>\n                <p className=\"font-mono font-extrabold text-2xl text-white\">\n                  {smartwatch.liveHeartRate} <span className=\"text-xs text-neutral-400\">BPM</span>\n                </p>\n                <span className=\"text-[10px] text-emerald-400 font-medium\">Zona: {smartwatch.activeZone}</span>\n              </div>\n\n              <div className=\"bg-neutral-800/60 p-3 rounded-2xl border border-neutral-700/60\">\n                <div className=\"flex items-center gap-1.5 text-cyan-400 text-xs font-bold mb-1\">\n                  <Activity className=\"w-3.5 h-3.5\" />\n                  <span>Pasos Hoy</span>\n                </div>\n                <p className=\"font-mono font-extrabold text-2xl text-white\">\n                  {smartwatch.stepsToday.toLocaleString()}\n                </p>\n                <span className=\"text-[10px] text-neutral-400 font-medium\">HRV: {smartwatch.hrvMs} ms</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => onNavigateTab(\'smartwatch\')}\n              className=\"text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center justify-between pt-2 border-t border-neutral-800\"\n            >\n              <span>Ver telemetr\303\255a avanzada</span>\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Global Quick Stats Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4\">\n        <div className=\"bg-neutral-900 border border-neutral-800 rounded-2xl p-4 shadow-lg\">\n          <div className=\"flex items-center justify-between text-neutral-400 mb-2\">\n            <span className=\"text-xs font-bold\">{t.totalWorkouts}</span>\n            <Dumbbell className=\"w-4 h-4 text-emerald-400\" />\n          </div>\n          <p className=\"font-mono font-extrabold text-2xl text-white\">{user.stats.totalWorkouts}</p>\n          <span className=\"text-[11px] text-emerald-400 font-medium\">\342\206\221 +4 esta semana</span>\n        </div>\n\n        <div className=\"bg-neutral-900 border border-neutral-800 rounded-2xl p-4 shadow-lg\">\n          <div className=\"flex items-center justify-between text-neutral-400 mb-2\">\n            <span className=\"text-xs font-bold\">{t.volumeLifted}</span>\n            <TrendingUp className=\"w-4 h-4 text-teal-400\" />\n          </div>\n          <p className=\"font-mono font-extrabold text-2xl text-white\">\n            {(user.stats.totalVolumeKg / 1000).toFixed(1)} <span className=\"text-sm font-sans\">ton</span>\n          </p>\n          <span className=\"text-[11px] text-neutral-400 font-medium\">{user.stats.totalVolumeKg.toLocaleString()} kg total</span>\n        </div>\n\n        <div className=\"bg-neutral-900 border border-neutral-800 rounded-2xl p-4 shadow-lg\">\n          <div className=\"flex items-center justify-between text-neutral-400 mb-2\">\n            <span className=\"text-xs font-bold\">{t.caloriesBurned}</span>\n            <Flame className=\"w-4 h-4 text-orange-400\" />\n          </div>\n          <p className=\"font-mono font-extrabold text-2xl text-white\">\n            {(user.stats.caloriesBurned / 1000).toFixed(1)}k <span className=\"text-sm font-sans\">kcal</span>\n          </p>\n          <span className=\"text-[11px] text-orange-400 font-medium\">~512 kcal / sesi\303\263n</span>\n        </div>\n\n        <div className=\"bg-neutral-900 border border-neutral-800 rounded-2xl p-4 shadow-lg\">\n          <div className=\"flex items-center justify-between text-neutral-400 mb-2\">\n            <span className=\"text-xs font-bold\">{t.minutesTrained}</span>\n            <Clock className=\"w-4 h-4 text-cyan-400\" />\n          </div>\n          <p className=\"font-mono font-extrabold text-2xl text-white\">\n            {Math.round(user.stats.totalMinutes / 60)} <span className=\"text-sm font-sans\">horas</span>\n          </p>\n          <span className=\"text-[11px] text-neutral-400 font-medium\">{user.stats.totalMinutes} min acumulados</span>\n        </div>\n      </div>\n\n      {/* Featured Weekly Community Challenge Card */}\n      {activeChallenge && (\n        <div className=\"bg-gradient-to-r from-neutral-900 via-neutral-900 to-emerald-950/40 border border-emerald-500/30 rounded-3xl p-5 sm:p-6 shadow-xl relative overflow-hidden\">\n          <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-emerald-500 text-black\">\n                  Reto Comunitario Destacado\n                </span>\n                <span className=\"text-xs font-bold text-emerald-400\">\n                  \342\217\263 {activeChallenge.daysRemaining} {t.daysLeft}\n                </span>\n              </div>\n              <h3 className=\"font-display font-extrabold text-xl sm:text-2xl text-white\">\n                {activeChallenge.title}\n              </h3>\n              <p className=\"text-xs sm:text-sm text-neutral-300 max-w-xl\">\n                {activeChallenge.description}\n              </p>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <div className=\"text-right hidden sm:block\">\n                <span className=\"text-xs font-bold text-neutral-400\">Recompensa</span>\n                <p className=\"text-base font-extrabold text-yellow-400 font-mono\">+{activeChallenge.rewardXp} XP</p>\n              </div>\n              <button\n                id=\"btn-dash-join-challenge\"\n                onClick={() => onNavigateTab(\'challenges\')}\n                className=\"px-5 py-2.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs shadow-lg shadow-emerald-500/20 transition-all hover:scale-105\"\n              >\n                {activeChallenge.joined ? \'Ver Progreso del Reto\' : t.joinChallenge}\n              </button>\n            </div>\n          </div>\n\n          {/* Progress bar */}\n          <div className=\"mt-4 pt-4 border-t border-neutral-800/80\">\n            <div className=\"flex justify-between text-xs font-bold text-neutral-300 mb-1.5\">\n              <span>{activeChallenge.currentProgress.toLocaleString()} / {activeChallenge.goalTarget.toLocaleString()} {activeChallenge.unit}</span>\n              <span className=\"text-emerald-400 font-mono\">\n                {Math.round((activeChallenge.currentProgress / activeChallenge.goalTarget) * 100)}%\n              </span>\n            </div>\n            <div className=\"h-2.5 bg-neutral-800 rounded-full overflow-hidden\">\n              <div\n                className=\"h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full\"\n                style={{ width: `${Math.min(100, (activeChallenge.currentProgress / activeChallenge.goalTarget) * 100)}%` }}\n              />\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Suggested Routines Section */}\n      <div>\n        <div className=\"flex items-center justify-between mb-4\">\n          <div>\n            <h3 className=\"font-display font-extrabold text-xl text-white\">\n              Rutinas Recomendadas para Hoy\n            </h3>\n            <p className=\"text-xs text-neutral-400\">Planes optimizados para tu nivel actual</p>\n          </div>\n          <button\n            onClick={() => onNavigateTab(\'routines\')}\n            className=\"text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1\"\n          >\n            <span>Ver todas ({routines.length})</span>\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {routines.slice(0, 3).map((routine) => (\n            <div\n              key={routine.id}\n              className=\"bg-neutral-900 border border-neutral-800 rounded-2xl p-5 hover:border-emerald-500/40 transition-all flex flex-col justify-between shadow-lg group\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between gap-2 mb-2\">\n                  <span className=\"text-[10px] font-extrabold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                    {routine.category}\n                  </span>\n                  <span className=\"text-xs font-bold text-yellow-400 font-mono\">\n                    +{routine.xpReward} XP\n                  </span>\n                </div>\n                <h4 className=\"font-display font-bold text-lg text-white group-hover:text-emerald-400 transition-colors\">\n                  {routine.title}\n                </h4>\n                <p className=\"text-xs text-neutral-400 mt-1 line-clamp-2\">\n                  {routine.description}\n                </p>\n              </div>\n\n              <div className=\"mt-4 pt-4 border-t border-neutral-800 flex items-center justify-between\">\n                <div className=\"text-xs text-neutral-400 space-x-2\">\n                  <span>\342\217\261 {routine.durationMinutes} min</span>\n                  <span>\360\237\224\245 {routine.estimatedCalories} kcal</span>\n                </div>\n                <button\n                  id={`btn-start-routine-${routine.id}`}\n                  onClick={() => onStartRoutine(routine)}\n                  className=\"px-3.5 py-1.5 rounded-xl bg-neutral-800 hover:bg-emerald-500 hover:text-black text-white text-xs font-bold transition-all shadow\"\n                >\n                  {t.startRoutine}\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
