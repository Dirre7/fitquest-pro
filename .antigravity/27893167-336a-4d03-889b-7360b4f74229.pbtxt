      target_content: "  return (\n    <header className=\"sticky top-0 z-40 bg-neutral-900/90 dark:bg-neutral-950/90 backdrop-blur-md border-b border-neutral-800 transition-colors\">\n      {/* Top Status Bar: Level, XP, Streak, Sync & Quick Controls */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-3\">\n          \n          {/* Logo & Level Pill */}\n          <div className=\"flex items-center gap-3\">\n            <button\n              id=\"btn-nav-logo\"\n              onClick={() => setCurrentTab(\'dashboard\')}\n              className=\"flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-lg p-1\"\n              aria-label=\"FitQuest Pro Inicio\"\n            >\n              <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform\">\n                <Dumbbell className=\"w-5 h-5 text-white transform -rotate-12\" />\n              </div>\n              <div className=\"text-left hidden sm:block\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"font-display font-extrabold text-lg text-white tracking-tight\">FitQuest</span>\n                  <span className=\"text-xs font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">PRO</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-400 font-medium truncate max-w-[140px]\">{t.tagline}</p>\n              </div>\n            </button>\n\n            {/* Level & XP Gauge */}\n            <div className=\"hidden md:flex items-center gap-2.5 bg-neutral-800/80 border border-neutral-700/60 rounded-xl px-3 py-1.5 shadow-inner\">\n              <div className=\"w-7 h-7 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-bold text-xs\">\n                {user.level}\n              </div>\n              <div className=\"w-24 lg:w-32\">\n                <div className=\"flex justify-between text-[10px] font-semibold text-neutral-300 mb-0.5\">\n                  <span>Nv. {user.level}</span>\n                  <span className=\"text-emerald-400 font-mono\">{user.currentLevelXp}/{user.nextLevelXp} XP</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-700 rounded-full overflow-hidden\">\n                  <div \n                    className=\"h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-500\"\n                    style={{ width: `${xpPercent}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Streak Counter */}\n            <div \n              className=\"flex items-center gap-1.5 bg-amber-500/10 border border-amber-500/30 rounded-xl px-2.5 py-1 text-amber-400 text-xs font-bold\"\n              title={`${user.stats.currentStreak} ${t.streakDays}`}\n            >\n              <Flame className=\"w-4 h-4 text-amber-500 animate-bounce\" />\n              <span>{user.stats.currentStreak} {t.streakDays.split(\' \')[0]}</span>\n            </div>\n          </div>\n\n          {/* Right Header Actions: Smartwatch status, Cloud sync, Sound, Lang, Theme, Quick Start */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            \n            {/* Live Smartwatch Indicator */}\n            <button\n              id=\"btn-nav-smartwatch\"\n              onClick={() => setCurrentTab(\'smartwatch\')}\n              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-semibold border transition-all ${\n                smartwatch.status === \'connected\'\n                  ? \'bg-emerald-950/60 border-emerald-500/40 text-emerald-300 hover:bg-emerald-900/60\'\n                  : \'bg-neutral-800/60 border-neutral-700 text-neutral-400 hover:text-white\'\n              }`}\n              title={smartwatch.status === \'connected\' ? `${smartwatch.name} - ${smartwatch.liveHeartRate} BPM` : \'Vincular Smartwatch\'}\n            >\n              <Watch className={`w-3.5 h-3.5 ${smartwatch.status === \'connected\' ? \'text-emerald-400\' : \'\'}`} />\n              {smartwatch.status === \'connected\' ? (\n                <span className=\"flex items-center gap-1\">\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping inline-block\" />\n                  <span className=\"font-mono\">{smartwatch.liveHeartRate} <span className=\"text-[10px] opacity-75\">BPM</span></span>\n                </span>\n              ) : (\n                <span className=\"hidden sm:inline\">Watch</span>\n              )}\n            </button>\n\n            {/* Cloud Sync / Offline Toggle */}\n            <button\n              id=\"btn-nav-cloud-sync\"\n              onClick={() => setIsOffline(!isOffline)}\n              className={`p-2 rounded-xl border text-xs font-medium transition-colors ${\n                isOffline\n                  ? \'bg-amber-950/40 border-amber-500/40 text-amber-400\'\n                  : \'bg-neutral-800/80 border-neutral-700/70 text-emerald-400 hover:bg-neutral-800\'\n              }`}\n              title={isOffline ? t.offlineActive : t.onlineActive}\n              aria-label={isOffline ? t.offlineMode : t.cloudSyncTitle}\n            >\n              {isOffline ? <CloudOff className=\"w-4 h-4 text-amber-400\" /> : <Cloud className=\"w-4 h-4 text-emerald-400\" />}\n            </button>\n\n            {/* Sound Toggle */}\n            <button\n              id=\"btn-nav-sound\"\n              onClick={() => {\n                const nextState = !isSoundMuted;\n                setIsSoundMuted(nextState);\n                sound.setMuted(nextState);\n                if (!nextState) sound.playBeep(900, 100);\n              }}\n              className=\"p-2 rounded-xl bg-neutral-800/80 border border-neutral-700/70 text-neutral-300 hover:text-white transition-colors\"\n              title={isSoundMuted ? \'Activar sonido\' : \'Silenciar\'}\n              aria-label=\"Alternar sonido\"\n            >\n              {isSoundMuted ? <VolumeX className=\"w-4 h-4 text-neutral-500\" /> : <Volume2 className=\"w-4 h-4 text-emerald-400\" />}\n            </button>\n\n            {/* Theme Toggle (Dark / Light) */}\n            <button\n              id=\"btn-nav-theme\"\n              onClick={() => setTheme(theme === \'dark\' ? \'light\' : \'dark\')}\n              className=\"p-2 rounded-xl bg-neutral-800/80 border border-neutral-700/70 text-neutral-300 hover:text-white transition-colors\"\n              title={`Tema: ${theme}`}\n              aria-label=\"Cambiar tema visual\"\n            >\n              {theme === \'dark\' ? <Moon className=\"w-4 h-4 text-cyan-400\" /> : <Sun className=\"w-4 h-4 text-amber-400\" />}\n            </button>\n\n            {/* Language Selector Dropdown */}\n            <div className=\"relative\">\n              <button\n                id=\"btn-nav-language\"\n                onClick={() => setLangMenuOpen(!langMenuOpen)}\n                className=\"p-2 rounded-xl bg-neutral-800/80 border border-neutral-700/70 text-neutral-300 hover:text-white flex items-center gap-1 text-xs uppercase font-bold\"\n                aria-label=\"Seleccionar idioma\"\n              >\n                <Languages className=\"w-4 h-4 text-emerald-400\" />\n                <span>{lang}</span>\n              </button>\n\n              {langMenuOpen && (\n                <div className=\"absolute right-0 mt-2 w-36 bg-neutral-900 border border-neutral-700 rounded-xl shadow-2xl py-1 z-50 animate-in fade-in\">\n                  {([\'es\', \'en\', \'pt\', \'fr\', \'de\'] as Language[]).map((l) => (\n                    <button\n                      key={l}\n                      onClick={() => {\n                        setLang(l);\n                        setLangMenuOpen(false);\n                      }}\n                      className={`w-full px-3 py-2 text-left text-xs font-semibold flex items-center justify-between hover:bg-neutral-800 ${\n                        lang === l ? \'text-emerald-400 bg-neutral-800/50\' : \'text-neutral-300\'\n                      }`}\n                    >\n                      <span>\n                        {l === \'es\' && \'\360\237\207\252\360\237\207\270 Espa\303\261ol\'}\n                        {l === \'en\' && \'\360\237\207\272\360\237\207\270 English\'}\n                        {l === \'pt\' && \'\360\237\207\247\360\237\207\267 Portugu\303\252s\'}\n                        {l === \'fr\' && \'\360\237\207\253\360\237\207\267 Fran\303\247ais\'}\n                        {l === \'de\' && \'\360\237\207\251\360\237\207\252 Deutsch\'}\n                      </span>\n                      {lang === l && <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Notification Bell */}\n            <button\n              id=\"btn-nav-notifications\"\n              onClick={onOpenNotifications}\n              className=\"relative p-2 rounded-xl bg-neutral-800/80 border border-neutral-700/70 text-neutral-300 hover:text-white transition-colors\"\n              title=\"Notificaciones & Recordatorios\"\n              aria-label=\"Ver notificaciones\"\n            >\n              <Bell className=\"w-4 h-4\" />\n              {unreadNotifications > 0 && (\n                <span className=\"absolute -top-1 -right-1 w-4 h-4 bg-emerald-500 text-black font-extrabold text-[10px] rounded-full flex items-center justify-center animate-pulse\">\n                  {unreadNotifications}\n                </span>\n              )}\n            </button>\n\n            {/* Quick Start Workout Action Button */}\n            <button\n              id=\"btn-nav-quick-start\"\n              onClick={onOpenQuickStart}\n              className=\"hidden sm:flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-neutral-950 font-bold text-xs shadow-md shadow-emerald-500/25 transition-all hover:scale-105 active:scale-95\"\n            >\n              <Zap className=\"w-3.5 h-3.5 fill-current\" />\n              <span>{t.quickStart}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Bottom Horizontal Tab Navigation Bar (Scrollable on mobile) */}\n        <nav \n          className=\"flex space-x-1 overflow-x-auto py-2 no-scrollbar border-t border-neutral-800/60\"\n          aria-label=\"Secciones principales\"\n        >\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`tab-${item.id}`}\n                onClick={() => {\n                  setCurrentTab(item.id);\n                  sound.playBeep(650, 40);\n                }}\n                className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n                  isActive\n                    ? \'bg-emerald-500 text-neutral-950 shadow-md shadow-emerald-500/20 font-bold\'\n                    : \'text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/60\'\n                }`}\n                aria-current={isActive ? \'page\' : undefined}\n              >\n                <Icon className={`w-3.5 h-3.5 ${isActive ? \'text-neutral-950\' : \'text-neutral-400\'}`} />\n                <span>{item.label}</span>\n                {item.badge && (\n                  <span className={`text-[9px] px-1 rounded font-black ${isActive ? \'bg-black text-emerald-400\' : \'bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse\'}`}>\n                    {item.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );"
      replacement_content: "  return (\n    <header className=\"sticky top-0 z-40 bg-[#121214]/95 backdrop-blur-xl border-b border-white/5 shadow-2xl transition-colors\">\n      {/* Top Status Bar: Level, XP, Streak, Sync & Quick Controls */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16 gap-3\">\n          \n          {/* Logo & Level Pill */}\n          <div className=\"flex items-center gap-3\">\n            <button\n              id=\"btn-nav-logo\"\n              onClick={() => setCurrentTab(\'dashboard\')}\n              className=\"flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded-2xl p-1\"\n              aria-label=\"FitQuest Pro Inicio\"\n            >\n              <div className=\"w-10 h-10 bg-cyan-500 rounded-2xl flex items-center justify-center shadow-[0_0_20px_rgba(6,182,212,0.4)] group-hover:scale-105 transition-transform\">\n                <Dumbbell className=\"w-5 h-5 text-neutral-950 transform -rotate-12 stroke-[2.5]\" />\n              </div>\n              <div className=\"text-left hidden sm:block\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"font-display font-extrabold text-lg text-white tracking-tight\">FitQuest</span>\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 tracking-wider\">PRO</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-400 font-medium truncate max-w-[140px]\">{t.tagline}</p>\n              </div>\n            </button>\n\n            {/* Level & XP Gauge */}\n            <div className=\"hidden md:flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-2xl px-3 py-1.5 shadow-inner\">\n              <div className=\"w-7 h-7 rounded-xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 font-bold text-xs font-mono\">\n                {user.level}\n              </div>\n              <div className=\"w-24 lg:w-32\">\n                <div className=\"flex justify-between text-[10px] font-semibold text-neutral-300 mb-0.5\">\n                  <span className=\"font-mono text-neutral-400\">LV.{user.level}</span>\n                  <span className=\"text-cyan-400 font-mono\">{user.currentLevelXp}/{user.nextLevelXp} XP</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-800 rounded-full overflow-hidden\">\n                  <div \n                    className=\"h-full bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full shadow-[0_0_8px_rgba(6,182,212,0.5)] transition-all duration-500\"\n                    style={{ width: `${xpPercent}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Streak Counter */}\n            <div \n              className=\"flex items-center gap-1.5 bg-orange-500/10 border border-orange-500/30 rounded-2xl px-3 py-1 text-orange-400 text-xs font-bold shadow-[0_0_10px_rgba(249,115,22,0.15)]\"\n              title={`${user.stats.currentStreak} ${t.streakDays}`}\n            >\n              <Flame className=\"w-4 h-4 text-orange-400 animate-bounce\" />\n              <span className=\"font-mono\">{user.stats.currentStreak} {t.streakDays.split(\' \')[0]}</span>\n            </div>\n          </div>\n\n          {/* Right Header Actions: Smartwatch status, Cloud sync, Sound, Lang, Theme, Quick Start */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            \n            {/* Live Smartwatch Indicator matching Immersive UI Command style */}\n            <button\n              id=\"btn-nav-smartwatch\"\n              onClick={() => setCurrentTab(\'smartwatch\')}\n              className={`flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all ${\n                smartwatch.status === \'connected\'\n                  ? \'bg-white/5 border-white/10 text-neutral-200 hover:border-cyan-500/40\'\n                  : \'bg-white/5 border-white/5 text-neutral-400 hover:text-white\'\n              }`}\n              title={smartwatch.status === \'connected\' ? `${smartwatch.name} - ${smartwatch.liveHeartRate} BPM` : \'Vincular Smartwatch\'}\n            >\n              {smartwatch.status === \'connected\' ? (\n                <>\n                  <div className=\"w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse\" />\n                  <span className=\"text-[11px] tracking-tight hidden sm:inline\">SMARTWATCH:</span>\n                  <span className=\"text-cyan-400 font-bold\">{smartwatch.liveHeartRate} <span className=\"text-[9px] text-red-400\">BPM</span></span>\n                </>\n              ) : (\n                <>\n                  <Watch className=\"w-3.5 h-3.5 text-neutral-400\" />\n                  <span className=\"hidden sm:inline\">SMARTWATCH</span>\n                </>\n              )}\n            </button>\n\n            {/* Cloud Sync / Offline Toggle */}\n            <button\n              id=\"btn-nav-cloud-sync\"\n              onClick={() => setIsOffline(!isOffline)}\n              className={`p-2 rounded-xl border text-xs font-medium transition-colors ${\n                isOffline\n                  ? \'bg-orange-500/10 border-orange-500/30 text-orange-400\'\n                  : \'bg-white/5 border-white/10 text-cyan-400 hover:bg-white/10\'\n              }`}\n              title={isOffline ? t.offlineActive : t.onlineActive}\n              aria-label={isOffline ? t.offlineMode : t.cloudSyncTitle}\n            >\n              {isOffline ? <CloudOff className=\"w-4 h-4 text-orange-400\" /> : <Cloud className=\"w-4 h-4 text-cyan-400\" />}\n            </button>\n\n            {/* Sound Toggle */}\n            <button\n              id=\"btn-nav-sound\"\n              onClick={() => {\n                const nextState = !isSoundMuted;\n                setIsSoundMuted(nextState);\n                sound.setMuted(nextState);\n                if (!nextState) sound.playBeep(900, 100);\n              }}\n              className=\"p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white hover:border-cyan-500/30 transition-colors\"\n              title={isSoundMuted ? \'Activar sonido\' : \'Silenciar\'}\n              aria-label=\"Alternar sonido\"\n            >\n              {isSoundMuted ? <VolumeX className=\"w-4 h-4 text-neutral-500\" /> : <Volume2 className=\"w-4 h-4 text-cyan-400\" />}\n            </button>\n\n            {/* Theme Toggle (Dark / Light) */}\n            <button\n              id=\"btn-nav-theme\"\n              onClick={() => setTheme(theme === \'dark\' ? \'light\' : \'dark\')}\n              className=\"p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white hover:border-cyan-500/30 transition-colors\"\n              title={`Tema: ${theme}`}\n              aria-label=\"Cambiar tema visual\"\n            >\n              {theme === \'dark\' ? <Moon className=\"w-4 h-4 text-cyan-400\" /> : <Sun className=\"w-4 h-4 text-amber-400\" />}\n            </button>\n\n            {/* Language Selector Dropdown */}\n            <div className=\"relative\">\n              <button\n                id=\"btn-nav-language\"\n                onClick={() => setLangMenuOpen(!langMenuOpen)}\n                className=\"p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white flex items-center gap-1 text-xs uppercase font-bold font-mono\"\n                aria-label=\"Seleccionar idioma\"\n              >\n                <Languages className=\"w-4 h-4 text-cyan-400\" />\n                <span>{lang}</span>\n              </button>\n\n              {langMenuOpen && (\n                <div className=\"absolute right-0 mt-2 w-36 bg-[#121214] border border-white/10 rounded-2xl shadow-2xl py-1 z-50 animate-in fade-in\">\n                  {([\'es\', \'en\', \'pt\', \'fr\', \'de\'] as Language[]).map((l) => (\n                    <button\n                      key={l}\n                      onClick={() => {\n                        setLang(l);\n                        setLangMenuOpen(false);\n                      }}\n                      className={`w-full px-3 py-2 text-left text-xs font-semibold flex items-center justify-between hover:bg-white/5 ${\n                        lang === l ? \'text-cyan-400 bg-cyan-500/10 font-bold\' : \'text-neutral-300\'\n                      }`}\n                    >\n                      <span>\n                        {l === \'es\' && \'\360\237\207\252\360\237\207\270 Espa\303\261ol\'}\n                        {l === \'en\' && \'\360\237\207\272\360\237\207\270 English\'}\n                        {l === \'pt\' && \'\360\237\207\247\360\237\207\267 Portugu\303\252s\'}\n                        {l === \'fr\' && \'\360\237\207\253\360\237\207\267 Fran\303\247ais\'}\n                        {l === \'de\' && \'\360\237\207\251\360\237\207\252 Deutsch\'}\n                      </span>\n                      {lang === l && <CheckCircle2 className=\"w-3.5 h-3.5 text-cyan-400\" />}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Notification Bell */}\n            <button\n              id=\"btn-nav-notifications\"\n              onClick={onOpenNotifications}\n              className=\"relative p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white transition-colors\"\n              title=\"Notificaciones & Recordatorios\"\n              aria-label=\"Ver notificaciones\"\n            >\n              <Bell className=\"w-4 h-4\" />\n              {unreadNotifications > 0 && (\n                <span className=\"absolute -top-1 -right-1 w-4 h-4 bg-cyan-500 text-neutral-950 font-extrabold text-[10px] rounded-full flex items-center justify-center shadow-[0_0_8px_#06b6d4]\">\n                  {unreadNotifications}\n                </span>\n              )}\n            </button>\n\n            {/* Quick Start Workout Action Button */}\n            <button\n              id=\"btn-nav-quick-start\"\n              onClick={onOpenQuickStart}\n              className=\"hidden sm:flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-neutral-950 font-bold text-xs shadow-lg shadow-cyan-500/25 transition-all hover:scale-105 active:scale-95\"\n            >\n              <Zap className=\"w-3.5 h-3.5 fill-current\" />\n              <span>{t.quickStart}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Bottom Horizontal Tab Navigation Bar (Scrollable on mobile) */}\n        <nav \n          className=\"flex space-x-1 overflow-x-auto py-2 no-scrollbar border-t border-white/5\"\n          aria-label=\"Secciones principales\"\n        >\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`tab-${item.id}`}\n                onClick={() => {\n                  setCurrentTab(item.id);\n                  sound.playBeep(650, 40);\n                }}\n                className={`flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${\n                  isActive\n                    ? \'bg-cyan-500 text-neutral-950 shadow-[0_0_15px_rgba(6,182,212,0.4)] font-bold\'\n                    : \'text-neutral-400 hover:text-neutral-100 hover:bg-white/5\'\n                }`}\n                aria-current={isActive ? \'page\' : undefined}\n              >\n                <Icon className={`w-3.5 h-3.5 ${isActive ? \'text-neutral-950 stroke-[2.5]\' : \'text-neutral-400\'}`} />\n                <span>{item.label}</span>\n                {item.badge && (\n                  <span className={`text-[9px] px-1.5 rounded font-black ${isActive ? \'bg-black text-cyan-400\' : \'bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse\'}`}>\n                    {item.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );"
