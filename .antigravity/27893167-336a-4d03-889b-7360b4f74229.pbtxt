        }
        lines {
          text: "        const newSet: ExerciseSet = {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          id: `set_${Date.now()}_${Math.random()}`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
