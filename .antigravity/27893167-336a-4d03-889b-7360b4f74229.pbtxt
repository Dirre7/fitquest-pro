          text: "      return prev.map((ex, idx) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (idx !== currentExerciseIndex) return ex;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const lastSet = ex.sets[ex.sets.length - 1];"
