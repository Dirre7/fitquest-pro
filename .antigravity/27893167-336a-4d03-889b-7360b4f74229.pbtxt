      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n    --font-display: \'Outfit\', system-ui, -apple-system, sans-serif;\n  }\n\n  body {\n    font-family: var(--font-sans);\n  }\n\n  h1, h2, h3, h4, .font-display {\n    font-family: var(--font-display);\n  }\n}\n\n/* Custom smooth scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: rgba(15, 23, 42, 0.6);\n}\n\n::-webkit-scrollbar-thumb {\n  background: rgba(71, 85, 105, 0.6);\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(100, 116, 139, 0.9);\n}\n\n/* High contrast & accessibility focus outline */\n:focus-visible {\n  outline: 2px solid #10b981;\n  outline-offset: 2px;\n}\n\n/* Pulse animation for live heart rate and smartwatch */\n@keyframes heart-beat {\n  0%, 100% { transform: scale(1); }\n  14% { transform: scale(1.15); }\n  28% { transform: scale(1); }\n  42% { transform: scale(1.12); }\n  70% { transform: scale(1); }\n}\n\n.animate-heart-beat {\n  animation: heart-beat 1.2s infinite ease-in-out;\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n    --font-display: \'Outfit\', system-ui, -apple-system, sans-serif;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    background-color: #09090b;\n    color: #f4f4f5;\n  }\n\n  h1, h2, h3, h4, .font-display {\n    font-family: var(--font-display);\n  }\n}\n\n/* Custom smooth scrollbar for Immersive UI */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #09090b;\n}\n\n::-webkit-scrollbar-thumb {\n  background: rgba(6, 182, 212, 0.25);\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(6, 182, 212, 0.5);\n}\n\n/* High contrast & accessibility focus outline */\n:focus-visible {\n  outline: 2px solid #06b6d4;\n  outline-offset: 2px;\n}\n\n/* Pulse animation for live heart rate and smartwatch */\n@keyframes heart-beat {\n  0%, 100% { transform: scale(1); }\n  14% { transform: scale(1.15); }\n  28% { transform: scale(1); }\n  42% { transform: scale(1.12); }\n  70% { transform: scale(1); }\n}\n\n.animate-heart-beat {\n  animation: heart-beat 1.2s infinite ease-in-out;\n}\n\n/* Immersive Glow Utilities */\n.shadow-cyan-glow {\n  box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);\n}\n\n.shadow-cyan-glow-sm {\n  box-shadow: 0 0 10px rgba(6, 182, 212, 0.25);\n}\n\n.shadow-cyan-glow-lg {\n  box-shadow: 0 0 35px rgba(6, 182, 212, 0.45);\n}\n\n.shadow-red-glow {\n  box-shadow: 0 0 12px rgba(239, 68, 68, 0.5);\n}\n\n.shadow-amber-glow {\n  box-shadow: 0 0 14px rgba(245, 158, 11, 0.4);\n}\n\n.bg-immersive-card {\n  background-color: #121214;\n}\n\n.bg-immersive-panel {\n  background: linear-gradient(135deg, #18181b 0%, #09090b 100%);\n}"
    }
    instruction: "Enhance src/index.css with Immersive UI cyberpunk telemetry glows, cyan focus, and ambient dark backgrounds"
  }
}
