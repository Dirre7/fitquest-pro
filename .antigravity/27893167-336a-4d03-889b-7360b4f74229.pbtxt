    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // User profile documents: Any authenticated user can read profiles (for leaderboards/duels); only the user can write their own profile\n    match /users/{userId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null && request.auth.uid == userId;\n      \n      // User workout history subcollection\n      match /history/{historyId} {\n        allow read: if request.auth != null;\n        allow write: if request.auth != null && request.auth.uid == userId;\n      }\n\n      // User custom routines\n      match /routines/{routineId} {\n        allow read: if request.auth != null;\n        allow write: if request.auth != null && request.auth.uid == userId;\n      }\n    }\n\n    // Community challenges\n    match /challenges/{challengeId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null;\n    }\n\n    // Live duel match rooms\n    match /duelRooms/{roomId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null;\n    }\n\n    // Public leaderboards aggregate\n    match /leaderboards/{league} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null;\n    }\n  }\n}\n"
    }
