  user_input {
    user_response: "Apply the \"Immersive UI\" design theme to the app.\n[AIS_METADATA_SECTION_START]\nDesign name: Immersive UI\nDesign HTML: <!doctype html>\\n<html style=\\\"height: 100%; margin: 0;\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <script src=\\\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\\\"></script>\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\\\" rel=\\\"stylesheet\\\" />\\n    <style>\\n      body { margin: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; }\\n      /* Fallback classes in case Tailwind fails to load in sandbox */\\n      .h-full { height: 100%; }\\n      .w-full { width: 100%; }\\n      .flex { display: flex; }\\n      .flex-col { flex-direction: column; }\\n      .flex-1 { flex: 1 1 0%; }\\n    </style>\\n  </head>\\n  <body>\\n    <div class=\'w-[1024px] h-[768px] bg-[#09090b] text-white font-sans flex overflow-hidden p-0 m-0\'> <aside class=\'w-24 bg-[#121214] border-r border-white/5 flex flex-col items-center py-8 gap-10 shadow-2xl\'> <div class=\'w-12 h-12 bg-cyan-500 rounded-2xl flex items-center justify-center shadow-[0_0_20px_rgba(6,182,212,0.4)]\'> <svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'white\' stroke-width=\'2.5\'><path d=\'M18 13V19C18 20.1046 17.1046 21 16 21H8C6.89543 21 6 20.1046 6 19V13\'></path><path d=\'M12 15V3\'></path><path d=\'M7 8L12 3L17 8\'></path></svg> </div> <div class=\'flex flex-col gap-8 opacity-40\'> <svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'white\' stroke-width=\'2\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><path d=\'M3 9h18\'/><path d=\'M9 21V9\'/></svg> <svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'white\' stroke-width=\'2\'><path d=\'M12 20a8 8 0 1