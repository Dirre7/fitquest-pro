          text: "          setNumber: ex.sets.length + 1,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          targetReps: lastSet ? lastSet.targetReps : 10,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          actualReps: lastSet ? lastSet.actualReps : 10,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          targetWeightKg: lastSet ? lastSet.targetWeightKg : 50,"
