        target_content: "          {/* Logo & Level Pill */}\n          <div className=\"flex items-center gap-3\">\n            <button\n              id=\"btn-nav-logo\"\n              onClick={() => setCurrentTab(\'dashboard\')}\n              className=\"flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded-2xl p-1\"\n              aria-label=\"FitQuest Pro Inicio\"\n            >\n              <div className=\"w-10 h-10 bg-cyan-500 rounded-2xl flex items-center justify-center shadow-[0_0_20px_rgba(6,182,212,0.4)] group-hover:scale-105 transition-transform\">\n                <Dumbbell className=\"w-5 h-5 text-neutral-950 transform -rotate-12 stroke-[2.5]\" />\n              </div>\n              <div className=\"text-left hidden sm:block\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"font-display font-extrabold text-lg text-white tracking-tight\">FitQuest</span>\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 tracking-wider\">PRO</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-400 font-medium truncate max-w-[140px]\">{t.tagline}</p>\n              </div>\n            </button>\n\n            {/* Level & XP Gauge */}\n            <div className=\"hidden md:flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-2xl px-3 py-1.5 shadow-inner\">\n              <div className=\"w-7 h-7 rounded-xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 font-bold text-xs font-mono\">\n                {user.level}\n              </div>\n              <div className=\"w-24 lg:w-32\">\n                <div className=\"flex justify-between text-[10px] font-semibold text-neutral-300 mb-0.5\">\n                  <span className=\"font-mono text-neutral-400\">LV.{user.level}</span>\n                  <span className=\"text-cyan-400 font-mono\">{user.currentLevelXp}/{user.nextLevelXp} XP</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-800 rounded-full overflow-hidden\">\n                  <div \n                    className=\"h-full bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full shadow-[0_0_8px_rgba(6,182,212,0.5)] transition-all duration-500\"\n                    style={{ width: `${xpPercent}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Streak Counter */}\n            <div \n              className=\"flex items-center gap-1.5 bg-orange-500/10 border border-orange-500/30 rounded-2xl px-3 py-1 text-orange-400 text-xs font-bold shadow-[0_0_10px_rgba(249,115,22,0.15)]\"\n              title={`${user.stats.currentStreak} ${t.streakDays}`}\n            >\n              <Flame className=\"w-4 h-4 text-orange-400 animate-bounce\" />\n              <span className=\"font-mono\">{user.stats.currentStreak} {t.streakDays.split(\' \')[0]}</span>\n            </div>\n          </div>\n\n          {/* Right Header Actions: Smartwatch status, Cloud sync, Sound, Lang, Theme, Quick Start */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            \n            {/* Live Smartwatch Indicator matching Immersive UI Command style */}\n            <button\n              id=\"btn-nav-smartwatch\"\n              onClick={() => setCurrentTab(\'smartwatch\')}\n              className={`flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all ${\n                smartwatch.status === \'connected\'\n                  ? \'bg-white/5 border-white/10 text-neutral-200 hover:border-cyan-500/40\'\n                  : \'bg-white/5 border-white/5 text-neutral-400 hover:text-white\'\n              }`}\n              title={smartwatch.status === \'connected\' ? `${smartwatch.name} - ${smartwatch.liveHeartRate} BPM` : \'Vincular Smartwatch\'}\n            >\n              {smartwatch.status === \'connected\' ? (\n                <>\n                  <div className=\"w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse\" />\n                  <span className=\"text-[11px] tracking-tight hidden sm:inline\">SMARTWATCH:</span>\n                  <span className=\"text-cyan-400 font-bold\">{smartwatch.liveHeartRate} <span className=\"text-[9px] text-red-400\">BPM</span></span>\n                </>\n              ) : (\n                <>\n                  <Watch className=\"w-3.5 h-3.5 text-neutral-400\" />\n                  <span className=\"hidden sm:inline\">SMARTWATCH</span>\n                </>\n              )}\n            </button>\n\n            {/* Cloud Sync / Offline Toggle */}\n            <button\n              id=\"btn-nav-cloud-sync\"\n              onClick={() => setIsOffline(!isOffline)}\n              className={`p-2 rounded-xl border text-xs font-medium transition-colors ${\n                isOffline\n                  ? \'bg-orange-500/10 border-orange-500/30 text-orange-400\'\n                  : \'bg-white/5 border-white/10 text-cyan-400 hover:bg-white/10\'\n              }`}\n              title={isOffline ? t.offlineActive : t.onlineActive}\n              aria-label={isOffline ? t.offlineMode : t.cloudSyncTitle}\n            >\n              {isOffline ? <CloudOff className=\"w-4 h-4 text-orange-400\" /> : <Cloud className=\"w-4 h-4 text-cyan-400\" />}\n            </button>\n\n            {/* Sound Toggle */}\n            <button\n              id=\"btn-nav-sound\"\n              onClick={() => {\n                const nextState = !isSoundMuted;\n                setIsSoundMuted(nextState);\n                sound.setMuted(nextState);\n                if (!nextState) sound.playBeep(900, 100);\n              }}\n              className=\"p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white hover:border-cyan-500/30 transition-colors\"\n              title={isSoundMuted ? \'Activar sonido\' : \'Silenciar\'}\n              aria-label=\"Alternar sonido\"\n            >\n              {isSoundMuted ? <VolumeX className=\"w-4 h-4 text-neutral-500\" /> : <Volume2 className=\"w-4 h-4 text-cyan-400\" />}\n            </button>"
        replacement_content: "          {/* Logo & Level Pill */}\n          <div className=\"flex items-center gap-3\">\n            <button\n              id=\"btn-nav-logo\"\n              onClick={() => handleSetTab(\'dashboard\')}\n              className=\"flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded-2xl p-1\"\n              aria-label=\"FitQuest Pro Inicio\"\n            >\n              <div className=\"w-10 h-10 bg-cyan-500 rounded-2xl flex items-center justify-center shadow-[0_0_20px_rgba(6,182,212,0.4)] group-hover:scale-105 transition-transform\">\n                <Dumbbell className=\"w-5 h-5 text-neutral-950 transform -rotate-12 stroke-[2.5]\" />\n              </div>\n              <div className=\"text-left hidden sm:block\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"font-display font-extrabold text-lg text-white tracking-tight\">FitQuest</span>\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 tracking-wider\">PRO</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-400 font-medium truncate max-w-[140px]\">{t.tagline}</p>\n              </div>\n            </button>\n\n            {/* Level & XP Gauge */}\n            <div className=\"hidden md:flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-2xl px-3 py-1.5 shadow-inner\">\n              <div className=\"w-7 h-7 rounded-xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 font-bold text-xs font-mono\">\n                {user.level}\n              </div>\n              <div className=\"w-24 lg:w-32\">\n                <div className=\"flex justify-between text-[10px] font-semibold text-neutral-300 mb-0.5\">\n                  <span className=\"font-mono text-neutral-400\">LV.{user.level}</span>\n                  <span className=\"text-cyan-400 font-mono\">{user.currentLevelXp}/{user.nextLevelXp} XP</span>\n                </div>\n                <div className=\"h-1.5 bg-neutral-800 rounded-full overflow-hidden\">\n                  <div \n                    className=\"h-full bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full shadow-[0_0_8px_rgba(6,182,212,0.5)] transition-all duration-500\"\n                    style={{ width: `${xpPercent}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Streak Counter */}\n            <div \n              className=\"flex items-center gap-1.5 bg-orange-500/10 border border-orange-500/30 rounded-2xl px-3 py-1 text-orange-400 text-xs font-bold shadow-[0_0_10px_rgba(249,115,22,0.15)]\"\n              title={`${user?.stats?.currentStreak ?? 0} ${t.streakDays}`}\n            >\n              <Flame className=\"w-4 h-4 text-orange-400 animate-bounce\" />\n              <span className=\"font-mono\">{user?.stats?.currentStreak ?? 0} {t.streakDays.split(\' \')[0]}</span>\n            </div>\n          </div>\n\n          {/* Right Header Actions: Smartwatch status, Cloud sync, Sound, Lang, Theme, Quick Start */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2\">\n            \n            {/* Live Smartwatch Indicator matching Immersive UI Command style */}\n            <button\n              id=\"btn-nav-smartwatch\"\n              onClick={() => handleSetTab(\'smartwatch\')}\n              className={`flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all ${\n                isWatchConnected\n                  ? \'bg-white/5 border-white/10 text-neutral-200 hover:border-cyan-500/40\'\n                  : \'bg-white/5 border-white/5 text-neutral-400 hover:text-white\'\n              }`}\n              title={isWatchConnected ? `${watchName} - ${liveHeartRate} BPM` : \'Vincular Smartwatch\'}\n            >\n              {isWatchConnected ? (\n                <>\n                  <div className=\"w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse\" />\n                  <span className=\"text-[11px] tracking-tight hidden sm:inline\">SMARTWATCH:</span>\n                  <span className=\"text-cyan-400 font-bold\">{liveHeartRate} <span className=\"text-[9px] text-red-400\">BPM</span></span>\n                </>\n              ) : (\n                <>\n                  <Watch className=\"w-3.5 h-3.5 text-neutral-400\" />\n                  <span className=\"hidden sm:inline\">SMARTWATCH</span>\n                </>\n              )}\n            </button>\n\n            {/* Cloud Sync / Offline Toggle */}\n            <button\n              id=\"btn-nav-cloud-sync\"\n              onClick={handleToggleOffline}\n              className={`p-2 rounded-xl border text-xs font-medium transition-colors ${\n                isOffline\n                  ? \'bg-orange-500/10 border-orange-500/30 text-orange-400\'\n                  : \'bg-white/5 border-white/10 text-cyan-400 hover:bg-white/10\'\n              }`}\n              title={isOffline ? t.offlineActive : t.onlineActive}\n              aria-label={isOffline ? t.offlineMode : t.cloudSyncTitle}\n            >\n              {isOffline ? <CloudOff className=\"w-4 h-4 text-orange-400\" /> : <Cloud className=\"w-4 h-4 text-cyan-400\" />}\n            </button>\n\n            {/* Sound Toggle */}\n            <button\n              id=\"btn-nav-sound\"\n              onClick={handleToggleSound}\n              className=\"p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white hover:border-cyan-500/30 transition-colors\"\n              title={isSoundMuted ? \'Activar sonido\' : \'Silenciar\'}\n              aria-label=\"Alternar sonido\"\n            >\n              {isSoundMuted ? <VolumeX className=\"w-4 h-4 text-neutral-500\" /> : <Volume2 className=\"w-4 h-4 text-cyan-400\" />}\n            </button>"
