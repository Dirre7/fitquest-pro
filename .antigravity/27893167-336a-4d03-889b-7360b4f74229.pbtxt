          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Volver a la Sesi\303\263n"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              </button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <button"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                id=\"btn-confirm-save-workout\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onClick={handleConfirmFinish}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                className=\"flex-1 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black font-extrabold text-xs shadow-xl shadow-emerald-500/25 transition-transform hover:scale-105\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                className=\"flex-1 py-3 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-neutral-950 font-mono font-bold text-xs shadow-xl shadow-cyan-500/25 transition-transform hover:scale-105\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Guardar y Reclamar XP"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              </button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      )}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Transform ActiveWorkoutTracker to Immersive UI design theme with cyan glowing telemetry and HUD styling"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"fixed inset-0 z-50 bg-neutral-950/95 backdrop-blur-xl flex flex-col overflow-y-auto\">\n      {/* Top Session HUD Bar */}\n      <div className=\"sticky top-0 z-20 bg-neutral-900/90 border-b border-neutral-800 px-4 sm:px-6 py-3 flex items-center justify-between gap-3 shadow-xl\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400\">\n            <Timer className=\"w-5 h-5 animate-pulse\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"font-display font-bold text-white text-base sm:text-lg leading-tight truncate max-w-[200px] sm:max-w-md\">\n                {routine.title}\n              </h2>\n              <span className=\"text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">\n                {completionPercent}%\n              </span>\n            </div>\n            <p className=\"text-xs text-neutral-400 font-mono\">\n              {formatTime(elapsedSeconds)} \342\200\242 {totalVolume.toLocaleString()} kg {t.volumeLifted.toLowerCase()}\n            </p>\n          </div>\n        </div>\n\n        {/* Real-time Telemetry Widgets */}\n        <div className=\"flex items-center gap-2 sm:gap-4\">\n          {/* Live Heart Rate from Smartwatch */}\n          <div\n            className={`flex items-center gap-1.5 px-2.5 py-1 rounded-xl border text-xs font-bold ${getHrZoneColor(\n              smartwatch.liveHeartRate\n            )}`}\n            title={`Zona: ${smartwatch.activeZone}`}\n          >\n            <Heart className=\"w-4 h-4 fill-current animate-heart-beat\" />\n            <span className=\"font-mono\">{smartwatch.liveHeartRate}</span>\n            <span className=\"text-[10px] opacity-75 font-sans\">BPM</span>\n          </div>\n\n          {/* Active Calories */}\n          <div className=\"hidden sm:flex items-center gap-1 px-2.5 py-1 rounded-xl bg-orange-950/40 border border-orange-500/30 text-orange-400 text-xs font-bold\">\n            <Flame className=\"w-4 h-4 fill-current\" />\n            <span className=\"font-mono\">{liveCalories}</span>\n            <span className=\"text-[10px] opacity-75\">kcal</span>\n          </div>\n\n          {/* Pause / Play Toggle */}\n          <button\n            id=\"btn-workout-pause\"\n            onClick={() => setIsPaused(!isPaused)}\n            className=\"p-2 rounded-xl bg-neutral-800 border border-neutral-700 text-neutral-300 hover:text-white transition-colors\"\n            title={isPaused ? t.resume : t.pause}\n          >\n            {isPaused ? <Play className=\"w-4 h-4 text-emerald-400\" /> : <Pause className=\"w-4 h-4 text-amber-400\" />}\n          </button>\n\n          {/* Finish & Save Workout Button */}\n          <button\n            id=\"btn-workout-finish\"\n            onClick={handleOpenFinish}\n            className=\"px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-black font-bold text-xs shadow-lg shadow-emerald-500/20 transition-all hover:scale-105 active:scale-95\"\n          >\n            {t.finishWorkout}\n          </button>\n\n          {/* Close/Cancel session */}\n          <button\n            id=\"btn-workout-close\"\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-neutral-800/80 hover:bg-neutral-800 text-neutral-400 hover:text-white transition-colors\"\n            title={t.cancelWorkout}\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* PR Celebration Floating Toast Notification */}\n      {showPrNotification && (\n        <div className=\"fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-gradient-to-r from-amber-500 to-orange-500 text-black px-4 py-2.5 rounded-2xl shadow-2xl flex items-center gap-3 animate-bounce font-bold text-sm\">\n          <Award className=\"w-5 h-5 fill-current\" />\n          <span>{t.personalRecord}: {showPrNotification}</span>\n        </div>\n      )}\n\n      {/* Main Content Area */}\n      <div className=\"max-w-4xl mx-auto w-full px-4 sm:px-6 py-6 flex-1 flex flex-col gap-6\">\n        \n        {/* Exercise Switcher Tab Strip */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar\">\n          {exercises.map((ex, idx) => {\n            const isDone = ex.sets.every((s) => s.completed);\n            const isSelected = idx === currentExerciseIndex;\n            return (\n              <button\n                key={ex.id}\n                id={`btn-ex-tab-${idx}`}\n                onClick={() => setCurrentExerciseIndex(idx)}\n                className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all border ${\n                  isSelected\n                    ? \'bg-emerald-500 text-black border-emerald-400 shadow-md shadow-emerald-500/20\'\n                    : isDone\n                    ? \'bg-emerald-950/40 text-emerald-300 border-emerald-500/40\'\n                    : \'bg-neutral-900 text-neutral-400 border-neutral-800 hover:text-neutral-200\'\n                }`}\n              >\n                {isDone ? (\n                  <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                ) : (\n                  <span className=\"w-4 h-4 rounded-full bg-neutral-800 flex items-center justify-center text-[10px]\">\n                    {idx + 1}\n                  </span>\n                )}\n                <span>{ex.name}</span>\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Current Exercise Detail Card */}\n        {currentExercise && (\n          <div className=\"bg-neutral-900/90 border border-neutral-800 rounded-2xl p-4 sm:p-6 shadow-xl relative overflow-hidden\">\n            \n            {/* Header info */}\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-neutral-800\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-xs font-extrabold px-2 py-0.5 rounded bg-neutral-800 text-emerald-400 border border-neutral-700\">\n                    {currentExercise.muscleGroup}\n                  </span>\n                  <span className=\"text-xs font-semibold text-neutral-400\">\n                    {currentExercise.equipment}\n                  </span>\n                  {currentExercise.prKg ? (\n                    <span className=\"text-xs font-bold text-amber-400 flex items-center gap-1\">\n                      <Award className=\"w-3.5 h-3.5\" /> PR: {currentExercise.prKg} kg\n                    </span>\n                  ) : null}\n                </div>\n                <h3 className=\"font-display font-extrabold text-xl sm:text-2xl text-white mt-1\">\n                  {currentExercise.name}\n                </h3>\n              </div>\n\n              {/* Prev / Next Exercise quick buttons */}\n              <div className=\"flex items-center gap-2\">\n                <button\n                  id=\"btn-prev-exercise\"\n                  disabled={currentExerciseIndex === 0}\n                  onClick={() => setCurrentExerciseIndex((prev) => Math.max(0, prev - 1))}\n                  className=\"px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 disabled:opacity-30 disabled:pointer-events-none text-xs font-semibold flex items-center gap-1 transition-colors\"\n                >\n                  <ChevronLeft className=\"w-4 h-4\" /> {t.prevExercise}\n                </button>\n                <button\n                  id=\"btn-next-exercise\"\n                  disabled={currentExerciseIndex === exercises.length - 1}\n                  onClick={() => setCurrentExerciseIndex((prev) => Math.min(exercises.length - 1, prev + 1))}\n                  className=\"px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 disabled:opacity-30 disabled:pointer-events-none text-xs font-semibold flex items-center gap-1 transition-colors\"\n                >\n                  {t.nextExercise} <ChevronRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Instruction Tip */}\n            {currentExercise.instructions && (\n              <div className=\"mt-3 p-3 bg-neutral-800/50 border border-neutral-700/60 rounded-xl flex items-start gap-2.5 text-xs text-neutral-300 leading-relaxed\">\n                <Info className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n                <div>\n                  <p>{currentExercise.instructions}</p>\n                  {currentExercise.tip && (\n                    <p className=\"text-emerald-400 font-medium mt-1\">\360\237\222\241 {currentExercise.tip}</p>\n                  )}\n                </div>\n              </div>\n            )}\n\n            {/* Sets Logging Table */}\n            <div className=\"mt-6\">\n              <div className=\"grid grid-cols-12 gap-2 text-[11px] font-bold text-neutral-400 uppercase tracking-wider px-3 pb-2\">\n                <div className=\"col-span-2\">{t.set}</div>\n                <div className=\"col-span-4 text-center\">{t.weight}</div>\n                <div className=\"col-span-3 text-center\">{t.reps}</div>\n                <div className=\"col-span-3 text-center\">{t.completedSet}</div>\n              </div>\n\n              <div className=\"space-y-2.5\">\n                {currentExercise.sets.map((set, setIdx) => {\n                  const estimated1rm = Math.round(\n                    set.actualWeightKg / (1.0278 - 0.0278 * Math.min(10, set.actualReps || 1))\n                  );\n\n                  return (\n                    <div\n                      key={set.id}\n                      className={`grid grid-cols-12 gap-2 items-center p-3 rounded-xl border transition-all ${\n                        set.completed\n                          ? \'bg-emerald-950/30 border-emerald-500/40 text-emerald-100\'\n                          : \'bg-neutral-800/70 border-neutral-700/80 text-white\'\n                      }`}\n                    >\n                      {/* Set Number & Badge */}\n                      <div className=\"col-span-2 flex items-center gap-1.5\">\n                        <span className=\"w-6 h-6 rounded-lg bg-neutral-700 text-neutral-200 font-bold text-xs flex items-center justify-center\">\n                          {setIdx + 1}\n                        </span>\n                        {set.isWarmup && (\n                          <span className=\"text-[9px] font-extrabold px-1 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30\">\n                            W\n                          </span>\n                        )}\n                      </div>\n\n                      {/* Weight Adjuster (kg) */}\n                      <div className=\"col-span-4 flex items-center justify-center gap-1\">\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualWeightKg\', -2.5)}\n                          className=\"w-7 h-7 rounded-lg bg-neutral-700 hover:bg-neutral-600 text-white flex items-center justify-center font-bold\"\n                          title=\"-2.5 kg\"\n                        >\n                          <Minus className=\"w-3 h-3\" />\n                        </button>\n                        <div className=\"w-16 text-center\">\n                          <input\n                            type=\"number\"\n                            value={set.actualWeightKg}\n                            onChange={(e) => {\n                              const val = parseFloat(e.target.value) || 0;\n                              handleUpdateSetVal(set.id, \'actualWeightKg\', val - set.actualWeightKg);\n                            }}\n                            className=\"w-full bg-neutral-900/90 text-center font-mono font-bold text-sm rounded-lg py-1 border border-neutral-700 focus:border-emerald-500 focus:outline-none\"\n                          />\n                          {set.actualWeightKg > 0 && (\n                            <span className=\"text-[9px] text-neutral-400 block font-mono\">1RM: {estimated1rm}kg</span>\n                          )}\n                        </div>\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualWeightKg\', 2.5)}\n                          className=\"w-7 h-7 rounded-lg bg-neutral-700 hover:bg-neutral-600 text-white flex items-center justify-center font-bold\"\n                          title=\"+2.5 kg\"\n                        >\n                          <Plus className=\"w-3 h-3\" />\n                        </button>\n                      </div>\n\n                      {/* Reps Adjuster */}\n                      <div className=\"col-span-3 flex items-center justify-center gap-1\">\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualReps\', -1)}\n                          className=\"w-7 h-7 rounded-lg bg-neutral-700 hover:bg-neutral-600 text-white flex items-center justify-center font-bold\"\n                        >\n                          <Minus className=\"w-3 h-3\" />\n                        </button>\n                        <input\n                          type=\"number\"\n                          value={set.actualReps}\n                          onChange={(e) => {\n                            const val = parseInt(e.target.value) || 0;\n                            handleUpdateSetVal(set.id, \'actualReps\', val - set.actualReps);\n                          }}\n                          className=\"w-10 bg-neutral-900/90 text-center font-mono font-bold text-sm rounded-lg py-1 border border-neutral-700 focus:border-emerald-500 focus:outline-none\"\n                        />\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualReps\', 1)}\n                          className=\"w-7 h-7 rounded-lg bg-neutral-700 hover:bg-neutral-600 text-white flex items-center justify-center font-bold\"\n                        >\n                          <Plus className=\"w-3 h-3\" />\n                        </button>\n                      </div>\n\n                      {/* Complete Checkbox */}\n                      <div className=\"col-span-3 flex justify-center\">\n                        <button\n                          id={`btn-complete-set-${setIdx}`}\n                          onClick={() => handleToggleSet(set.id)}\n                          className={`w-10 h-10 rounded-xl flex items-center justify-center transition-all ${\n                            set.completed\n                              ? \'bg-emerald-500 text-black shadow-md shadow-emerald-500/30 scale-105\'\n                              : \'bg-neutral-700 hover:bg-neutral-600 text-neutral-300\'\n                          }`}\n                        >\n                          <Check className=\"w-5 h-5 stroke-[3]\" />\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n\n              {/* Add Set button */}\n              <button\n                id=\"btn-add-set\"\n                onClick={handleAddSet}\n                className=\"mt-4 w-full py-2.5 rounded-xl border border-dashed border-neutral-700 hover:border-emerald-500/50 hover:bg-neutral-800/50 text-xs font-bold text-neutral-300 flex items-center justify-center gap-1.5 transition-colors\"\n              >\n                <Plus className=\"w-4 h-4 text-emerald-400\" />\n                <span>Agregar Serie Adicional</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Interactive Rest Timer Card (Shown when resting) */}\n        {isResting && (\n          <div className=\"bg-gradient-to-br from-emerald-950/80 via-neutral-900 to-neutral-900 border-2 border-emerald-500/50 rounded-2xl p-5 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-4 animate-in fade-in\">\n            <div className=\"flex items-center gap-4\">\n              {/* Circular Countdown Progress Ring */}\n              <div className=\"relative w-16 h-16 flex items-center justify-center shrink-0\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-neutral-800\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-emerald-400 transition-all duration-1000\"\n                    strokeDasharray={`${(restRemaining / totalRestTime) * 100}, 100`}\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute font-mono font-extrabold text-base text-white\">\n                  {restRemaining}s\n                </span>\n              </div>\n\n              <div>\n                <h4 className=\"font-display font-bold text-white text-base\">{t.restTimer}</h4>\n                <p className=\"text-xs text-neutral-400\">Recupera el aliento y prep\303\241rate para la siguiente serie.</p>\n              </div>\n            </div>\n\n            {/* Rest control buttons */}\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={() => setRestRemaining((prev) => prev + 30)}\n                className=\"px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-xs font-bold text-emerald-400 border border-neutral-700\"\n              >\n                {t.addRest30}\n              </button>\n              <button\n                onClick={() => {\n                  setIsResting(false);\n                  setRestRemaining(0);\n                }}\n                className=\"px-4 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black text-xs font-bold shadow-md\"\n              >\n                {t.skipRest}\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Finish Workout Summary Modal */}\n      {showSummaryModal && (\n        <div className=\"fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4\">\n          <div className=\"bg-neutral-900 border border-neutral-700 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl animate-in zoom-in-95\">\n            <div className=\"text-center mb-6\">\n              <div className=\"w-16 h-16 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-400 mx-auto flex items-center justify-center text-black shadow-xl shadow-emerald-500/25 mb-3\">\n                <Trophy className=\"w-8 h-8\" />\n              </div>\n              <h3 className=\"font-display font-extrabold text-2xl text-white\">\n                {t.workoutCompleted}\n              </h3>\n              <p className=\"text-sm text-neutral-400 mt-1\">{routine.title}</p>\n            </div>\n\n            {/* Metrics Breakdown Grid */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-6\">\n              <div className=\"bg-neutral-800/80 p-3 rounded-2xl border border-neutral-700 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-bold uppercase\">{t.estimatedTime}</span>\n                <p className=\"text-base font-mono font-extrabold text-white mt-0.5\">{formatTime(elapsedSeconds)}</p>\n              </div>\n              <div className=\"bg-neutral-800/80 p-3 rounded-2xl border border-neutral-700 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-bold uppercase\">{t.volumeLifted}</span>\n                <p className=\"text-base font-mono font-extrabold text-emerald-400 mt-0.5\">{totalVolume} kg</p>\n              </div>\n              <div className=\"bg-neutral-800/80 p-3 rounded-2xl border border-neutral-700 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-bold uppercase\">{t.caloriesBurned}</span>\n                <p className=\"text-base font-mono font-extrabold text-orange-400 mt-0.5\">{liveCalories} kcal</p>\n              </div>\n              <div className=\"bg-neutral-800/80 p-3 rounded-2xl border border-neutral-700 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-bold uppercase\">{t.xpEarned}</span>\n                <p className=\"text-base font-mono font-extrabold text-yellow-400 mt-0.5\">\n                  +{Math.round(routine.xpReward * Math.max(0.6, completionPercent / 100))} XP\n                </p>\n              </div>\n            </div>\n\n            {/* PRs achieved */}\n            {unlockedPrs.length > 0 && (\n              <div className=\"mb-4 p-3 bg-amber-500/10 border border-amber-500/30 rounded-2xl\">\n                <div className=\"flex items-center gap-1.5 text-amber-400 font-bold text-xs mb-1\">\n                  <Sparkles className=\"w-4 h-4\" />\n                  <span>{t.personalRecord}</span>\n                </div>\n                <ul className=\"text-xs text-neutral-300 space-y-1\">\n                  {unlockedPrs.map((pr, i) => (\n                    <li key={i}>\342\200\242 {pr}</li>\n                  ))}\n                </ul>\n              </div>\n            )}\n\n            {/* Session Feeling Rating (1-5 stars) */}\n            <div className=\"mb-4\">\n              <label className=\"text-xs font-bold text-neutral-300 block mb-2\">\n                \302\277C\303\263mo te has sentido en esta sesi\303\263n?\n              </label>\n              <div className=\"flex justify-center gap-2\">\n                {[1, 2, 3, 4, 5].map((star) => (\n                  <button\n                    key={star}\n                    onClick={() => setRating(star)}\n                    className={`w-10 h-10 rounded-xl text-lg font-bold transition-transform ${\n                      rating >= star\n                        ? \'bg-amber-400 text-black scale-110 shadow-md shadow-amber-400/20\'\n                        : \'bg-neutral-800 text-neutral-500\'\n                    }`}\n                  >\n                    \342\230\205\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Notes textarea */}\n            <div className=\"mb-6\">\n              <input\n                type=\"text\"\n                value={notes}\n                onChange={(e) => setNotes(e.target.value)}\n                placeholder=\"Notas de la sesi\303\263n (ej. \'Excelente congesti\303\263n en banca...\')\"\n                className=\"w-full px-4 py-2.5 bg-neutral-800 border border-neutral-700 rounded-xl text-xs text-white placeholder-neutral-500 focus:border-emerald-500 focus:outline-none\"\n              />\n            </div>\n\n            {/* Confirm & Save Button */}\n            <div className=\"flex gap-3\">\n              <button\n                onClick={() => setShowSummaryModal(false)}\n                className=\"flex-1 py-3 rounded-2xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-bold text-xs transition-colors\"\n              >\n                Volver a la Sesi\303\263n\n              </button>\n              <button\n                id=\"btn-confirm-save-workout\"\n                onClick={handleConfirmFinish}\n                className=\"flex-1 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black font-extrabold text-xs shadow-xl shadow-emerald-500/25 transition-transform hover:scale-105\"\n              >\n                Guardar y Reclamar XP\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 bg-[#09090b]/95 backdrop-blur-2xl flex flex-col overflow-y-auto\">\n      {/* Top Session HUD Bar */}\n      <div className=\"sticky top-0 z-20 bg-[#121214]/90 backdrop-blur-xl border-b border-white/5 px-4 sm:px-6 py-3 flex items-center justify-between gap-3 shadow-2xl\">\n        <div className=\"flex items-center gap-3.5\">\n          <div className=\"w-10 h-10 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shadow-[0_0_12px_rgba(6,182,212,0.25)]\">\n            <Timer className=\"w-5 h-5 animate-pulse\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"font-display font-bold text-white text-base sm:text-lg leading-tight truncate max-w-[200px] sm:max-w-md\">\n                {routine.title}\n              </h2>\n              <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20\">\n                {completionPercent}%\n              </span>\n            </div>\n            <p className=\"text-xs text-neutral-400 font-mono\">\n              {formatTime(elapsedSeconds)} \342\200\242 {totalVolume.toLocaleString()} kg {t.volumeLifted.toLowerCase()}\n            </p>\n          </div>\n        </div>\n\n        {/* Real-time Telemetry Widgets */}\n        <div className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Live Heart Rate from Smartwatch */}\n          <div\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-2xl border text-xs font-mono font-bold ${getHrZoneColor(\n              smartwatch.liveHeartRate\n            )}`}\n            title={`Zona: ${smartwatch.activeZone}`}\n          >\n            <Heart className=\"w-4 h-4 fill-current animate-heart-beat\" />\n            <span>{smartwatch.liveHeartRate}</span>\n            <span className=\"text-[10px] opacity-75 font-sans font-normal\">BPM</span>\n          </div>\n\n          {/* Active Calories */}\n          <div className=\"hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-2xl bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono font-bold shadow-[0_0_10px_rgba(249,115,22,0.15)]\">\n            <Flame className=\"w-4 h-4 fill-current\" />\n            <span>{liveCalories}</span>\n            <span className=\"text-[10px] opacity-75 font-sans font-normal\">kcal</span>\n          </div>\n\n          {/* Pause / Play Toggle */}\n          <button\n            id=\"btn-workout-pause\"\n            onClick={() => setIsPaused(!isPaused)}\n            className=\"p-2.5 rounded-2xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white hover:bg-white/10 transition-colors\"\n            title={isPaused ? t.resume : t.pause}\n          >\n            {isPaused ? <Play className=\"w-4 h-4 text-cyan-400\" /> : <Pause className=\"w-4 h-4 text-amber-400\" />}\n          </button>\n\n          {/* Finish & Save Workout Button */}\n          <button\n            id=\"btn-workout-finish\"\n            onClick={handleOpenFinish}\n            className=\"px-4 py-2 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-neutral-950 font-mono font-bold text-xs shadow-lg shadow-cyan-500/25 transition-all hover:scale-105 active:scale-95\"\n          >\n            {t.finishWorkout}\n          </button>\n\n          {/* Close/Cancel session */}\n          <button\n            id=\"btn-workout-close\"\n            onClick={onClose}\n            className=\"p-2.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 text-neutral-400 hover:text-white transition-colors\"\n            title={t.cancelWorkout}\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* PR Celebration Floating Toast Notification */}\n      {showPrNotification && (\n        <div className=\"fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-gradient-to-r from-amber-400 to-yellow-500 text-neutral-950 px-5 py-3 rounded-2xl shadow-[0_0_25px_rgba(245,158,11,0.5)] flex items-center gap-3 animate-bounce font-mono font-bold text-xs border border-amber-300\">\n          <Award className=\"w-5 h-5 fill-current\" />\n          <span>{t.personalRecord}: {showPrNotification}</span>\n        </div>\n      )}\n\n      {/* Main Content Area */}\n      <div className=\"max-w-4xl mx-auto w-full px-4 sm:px-6 py-6 flex-1 flex flex-col gap-6\">\n        \n        {/* Exercise Switcher Tab Strip */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar\">\n          {exercises.map((ex, idx) => {\n            const isDone = ex.sets.every((s) => s.completed);\n            const isSelected = idx === currentExerciseIndex;\n            return (\n              <button\n                key={ex.id}\n                id={`btn-ex-tab-${idx}`}\n                onClick={() => setCurrentExerciseIndex(idx)}\n                className={`flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs font-mono font-bold whitespace-nowrap transition-all border ${\n                  isSelected\n                    ? \'bg-cyan-500 text-neutral-950 border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.35)]\'\n                    : isDone\n                    ? \'bg-emerald-500/10 text-emerald-400 border-emerald-500/30\'\n                    : \'bg-[#121214] text-neutral-400 border-white/5 hover:text-neutral-200 hover:border-white/10\'\n                }`}\n              >\n                {isDone ? (\n                  <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n                ) : (\n                  <span className=\"w-4 h-4 rounded-full bg-white/10 flex items-center justify-center text-[10px]\">\n                    {idx + 1}\n                  </span>\n                )}\n                <span>{ex.name}</span>\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Current Exercise Detail Card */}\n        {currentExercise && (\n          <div className=\"bg-[#121214] border border-white/5 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden\">\n            <div className=\"absolute top-0 right-0 w-48 h-48 bg-cyan-500/5 blur-3xl pointer-events-none\" />\n            \n            {/* Header info */}\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-white/5 relative z-10\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 uppercase tracking-wider\">\n                    {currentExercise.muscleGroup}\n                  </span>\n                  <span className=\"text-xs font-mono text-neutral-400\">\n                    {currentExercise.equipment}\n                  </span>\n                  {currentExercise.prKg ? (\n                    <span className=\"text-xs font-mono font-bold text-amber-400 flex items-center gap-1\">\n                      <Award className=\"w-3.5 h-3.5\" /> PR: {currentExercise.prKg} kg\n                    </span>\n                  ) : null}\n                </div>\n                <h3 className=\"font-display font-extrabold text-xl sm:text-2xl text-white mt-1.5\">\n                  {currentExercise.name}\n                </h3>\n              </div>\n\n              {/* Prev / Next Exercise quick buttons */}\n              <div className=\"flex items-center gap-2\">\n                <button\n                  id=\"btn-prev-exercise\"\n                  disabled={currentExerciseIndex === 0}\n                  onClick={() => setCurrentExerciseIndex((prev) => Math.max(0, prev - 1))}\n                  className=\"px-3.5 py-2 rounded-2xl bg-white/5 hover:bg-white/10 text-neutral-300 disabled:opacity-30 disabled:pointer-events-none text-xs font-mono font-semibold flex items-center gap-1 transition-colors border border-white/5\"\n                >\n                  <ChevronLeft className=\"w-4 h-4\" /> {t.prevExercise}\n                </button>\n                <button\n                  id=\"btn-next-exercise\"\n                  disabled={currentExerciseIndex === exercises.length - 1}\n                  onClick={() => setCurrentExerciseIndex((prev) => Math.min(exercises.length - 1, prev + 1))}\n                  className=\"px-3.5 py-2 rounded-2xl bg-white/5 hover:bg-white/10 text-neutral-300 disabled:opacity-30 disabled:pointer-events-none text-xs font-mono font-semibold flex items-center gap-1 transition-colors border border-white/5\"\n                >\n                  {t.nextExercise} <ChevronRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Instruction Tip */}\n            {currentExercise.instructions && (\n              <div className=\"mt-4 p-4 bg-white/5 border border-white/5 rounded-2xl flex items-start gap-3 text-xs text-neutral-300 leading-relaxed relative z-10\">\n                <Info className=\"w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" />\n                <div>\n                  <p>{currentExercise.instructions}</p>\n                  {currentExercise.tip && (\n                    <p className=\"text-cyan-400 font-medium mt-1\">\360\237\222\241 {currentExercise.tip}</p>\n                  )}\n                </div>\n              </div>\n            )}\n\n            {/* Sets Logging Table */}\n            <div className=\"mt-6 relative z-10\">\n              <div className=\"grid grid-cols-12 gap-2 text-[11px] font-mono font-bold text-neutral-400 uppercase tracking-wider px-3 pb-2\">\n                <div className=\"col-span-2\">{t.set}</div>\n                <div className=\"col-span-4 text-center\">{t.weight}</div>\n                <div className=\"col-span-3 text-center\">{t.reps}</div>\n                <div className=\"col-span-3 text-center\">{t.completedSet}</div>\n              </div>\n\n              <div className=\"space-y-3\">\n                {currentExercise.sets.map((set, setIdx) => {\n                  const estimated1rm = Math.round(\n                    set.actualWeightKg / (1.0278 - 0.0278 * Math.min(10, set.actualReps || 1))\n                  );\n\n                  return (\n                    <div\n                      key={set.id}\n                      className={`grid grid-cols-12 gap-2 items-center p-3.5 rounded-2xl border transition-all ${\n                        set.completed\n                          ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-100 shadow-[0_0_15px_rgba(6,182,212,0.1)]\'\n                          : \'bg-white/5 border-white/5 text-white\'\n                      }`}\n                    >\n                      {/* Set Number & Badge */}\n                      <div className=\"col-span-2 flex items-center gap-1.5\">\n                        <span className=\"w-6 h-6 rounded-lg bg-white/10 text-neutral-200 font-mono font-bold text-xs flex items-center justify-center\">\n                          {setIdx + 1}\n                        </span>\n                        {set.isWarmup && (\n                          <span className=\"text-[9px] font-mono font-extrabold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30\">\n                            W\n                          </span>\n                        )}\n                      </div>\n\n                      {/* Weight Adjuster (kg) */}\n                      <div className=\"col-span-4 flex items-center justify-center gap-1.5\">\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualWeightKg\', -2.5)}\n                          className=\"w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 text-white flex items-center justify-center font-bold border border-white/5\"\n                          title=\"-2.5 kg\"\n                        >\n                          <Minus className=\"w-3 h-3\" />\n                        </button>\n                        <div className=\"w-18 text-center\">\n                          <input\n                            type=\"number\"\n                            value={set.actualWeightKg}\n                            onChange={(e) => {\n                              const val = parseFloat(e.target.value) || 0;\n                              handleUpdateSetVal(set.id, \'actualWeightKg\', val - set.actualWeightKg);\n                            }}\n                            className=\"w-full bg-[#09090b] text-center font-mono font-bold text-sm rounded-xl py-1.5 border border-white/10 focus:border-cyan-500 focus:outline-none text-white\"\n                          />\n                          {set.actualWeightKg > 0 && (\n                            <span className=\"text-[9px] text-neutral-400 block font-mono mt-0.5\">1RM: {estimated1rm}kg</span>\n                          )}\n                        </div>\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualWeightKg\', 2.5)}\n                          className=\"w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 text-white flex items-center justify-center font-bold border border-white/5\"\n                          title=\"+2.5 kg\"\n                        >\n                          <Plus className=\"w-3 h-3\" />\n                        </button>\n                      </div>\n\n                      {/* Reps Adjuster */}\n                      <div className=\"col-span-3 flex items-center justify-center gap-1.5\">\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualReps\', -1)}\n                          className=\"w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 text-white flex items-center justify-center font-bold border border-white/5\"\n                        >\n                          <Minus className=\"w-3 h-3\" />\n                        </button>\n                        <input\n                          type=\"number\"\n                          value={set.actualReps}\n                          onChange={(e) => {\n                            const val = parseInt(e.target.value) || 0;\n                            handleUpdateSetVal(set.id, \'actualReps\', val - set.actualReps);\n                          }}\n                          className=\"w-12 bg-[#09090b] text-center font-mono font-bold text-sm rounded-xl py-1.5 border border-white/10 focus:border-cyan-500 focus:outline-none text-white\"\n                        />\n                        <button\n                          onClick={() => handleUpdateSetVal(set.id, \'actualReps\', 1)}\n                          className=\"w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 text-white flex items-center justify-center font-bold border border-white/5\"\n                        >\n                          <Plus className=\"w-3 h-3\" />\n                        </button>\n                      </div>\n\n                      {/* Complete Checkbox */}\n                      <div className=\"col-span-3 flex justify-center\">\n                        <button\n                          id={`btn-complete-set-${setIdx}`}\n                          onClick={() => handleToggleSet(set.id)}\n                          className={`w-10 h-10 rounded-2xl flex items-center justify-center transition-all ${\n                            set.completed\n                              ? \'bg-cyan-500 text-neutral-950 shadow-[0_0_15px_rgba(6,182,212,0.4)] scale-105\'\n                              : \'bg-white/5 hover:bg-white/10 text-neutral-300 border border-white/10\'\n                          }`}\n                        >\n                          <Check className=\"w-5 h-5 stroke-[3]\" />\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n\n              {/* Add Set button */}\n              <button\n                id=\"btn-add-set\"\n                onClick={handleAddSet}\n                className=\"mt-5 w-full py-3 rounded-2xl border border-dashed border-white/10 hover:border-cyan-500/50 hover:bg-white/5 text-xs font-mono font-bold text-neutral-300 flex items-center justify-center gap-2 transition-colors\"\n              >\n                <Plus className=\"w-4 h-4 text-cyan-400\" />\n                <span>Agregar Serie Adicional</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Interactive Rest Timer Card (Shown when resting) */}\n        {isResting && (\n          <div className=\"bg-[#121214] border-2 border-cyan-500/40 rounded-3xl p-6 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-5 animate-in fade-in relative overflow-hidden\">\n            <div className=\"absolute top-0 right-0 w-48 h-48 bg-cyan-500/10 blur-3xl pointer-events-none\" />\n            \n            <div className=\"flex items-center gap-4 relative z-10\">\n              {/* Circular Countdown Progress Ring */}\n              <div className=\"relative w-16 h-16 flex items-center justify-center shrink-0\">\n                <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                  <path\n                    className=\"text-white/10\"\n                    strokeWidth=\"3.5\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                  <path\n                    className=\"text-cyan-400 transition-all duration-1000\"\n                    strokeDasharray={`${(restRemaining / totalRestTime) * 100}, 100`}\n                    strokeWidth=\"3.5\"\n                    strokeLinecap=\"round\"\n                    stroke=\"currentColor\"\n                    fill=\"none\"\n                    d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                  />\n                </svg>\n                <span className=\"absolute font-mono font-extrabold text-base text-white\">\n                  {restRemaining}s\n                </span>\n              </div>\n\n              <div>\n                <h4 className=\"font-display font-bold text-white text-base\">{t.restTimer}</h4>\n                <p className=\"text-xs text-neutral-400\">Recupera el aliento y prep\303\241rate para la siguiente serie.</p>\n              </div>\n            </div>\n\n            {/* Rest control buttons */}\n            <div className=\"flex items-center gap-3 relative z-10\">\n              <button\n                onClick={() => setRestRemaining((prev) => prev + 30)}\n                className=\"px-3.5 py-2 rounded-2xl bg-white/5 hover:bg-white/10 text-xs font-mono font-bold text-cyan-400 border border-white/10\"\n              >\n                {t.addRest30}\n              </button>\n              <button\n                onClick={() => {\n                  setIsResting(false);\n                  setRestRemaining(0);\n                }}\n                className=\"px-5 py-2 rounded-2xl bg-cyan-500 hover:bg-cyan-400 text-neutral-950 text-xs font-mono font-bold shadow-lg shadow-cyan-500/20\"\n              >\n                {t.skipRest}\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Finish Workout Summary Modal */}\n      {showSummaryModal && (\n        <div className=\"fixed inset-0 z-50 bg-black/85 backdrop-blur-xl flex items-center justify-center p-4\">\n          <div className=\"bg-[#121214] border border-white/10 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl animate-in zoom-in-95 relative overflow-hidden\">\n            <div className=\"absolute top-0 right-0 w-48 h-48 bg-cyan-500/10 blur-3xl pointer-events-none\" />\n            \n            <div className=\"text-center mb-6 relative z-10\">\n              <div className=\"w-16 h-16 rounded-3xl bg-gradient-to-tr from-cyan-500 to-blue-600 mx-auto flex items-center justify-center text-neutral-950 shadow-xl shadow-cyan-500/30 mb-3.5\">\n                <Trophy className=\"w-8 h-8\" />\n              </div>\n              <h3 className=\"font-display font-extrabold text-2xl text-white\">\n                {t.workoutCompleted}\n              </h3>\n              <p className=\"text-sm text-neutral-400 mt-1\">{routine.title}</p>\n            </div>\n\n            {/* Metrics Breakdown Grid */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 relative z-10\">\n              <div className=\"bg-white/5 p-3.5 rounded-2xl border border-white/5 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-mono uppercase\">{t.estimatedTime}</span>\n                <p className=\"text-base font-mono font-extrabold text-white mt-0.5\">{formatTime(elapsedSeconds)}</p>\n              </div>\n              <div className=\"bg-white/5 p-3.5 rounded-2xl border border-white/5 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-mono uppercase\">{t.volumeLifted}</span>\n                <p className=\"text-base font-mono font-extrabold text-cyan-400 mt-0.5\">{totalVolume} kg</p>\n              </div>\n              <div className=\"bg-white/5 p-3.5 rounded-2xl border border-white/5 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-mono uppercase\">{t.caloriesBurned}</span>\n                <p className=\"text-base font-mono font-extrabold text-orange-400 mt-0.5\">{liveCalories} kcal</p>\n              </div>\n              <div className=\"bg-white/5 p-3.5 rounded-2xl border border-white/5 text-center\">\n                <span className=\"text-[10px] text-neutral-400 font-mono uppercase\">{t.xpEarned}</span>\n                <p className=\"text-base font-mono font-extrabold text-cyan-400 mt-0.5\">\n                  +{Math.round(routine.xpReward * Math.max(0.6, completionPercent / 100))} XP\n                </p>\n              </div>\n            </div>\n\n            {/* PRs achieved */}\n            {unlockedPrs.length > 0 && (\n              <div className=\"mb-4 p-4 bg-amber-500/10 border border-amber-500/20 rounded-2xl relative z-10\">\n                <div className=\"flex items-center gap-1.5 text-amber-400 font-mono font-bold text-xs mb-1\">\n                  <Sparkles className=\"w-4 h-4\" />\n                  <span>{t.personalRecord}</span>\n                </div>\n                <ul className=\"text-xs text-neutral-300 space-y-1 font-mono\">\n                  {unlockedPrs.map((pr, i) => (\n                    <li key={i}>\342\200\242 {pr}</li>\n                  ))}\n                </ul>\n              </div>\n            )}\n\n            {/* Session Feeling Rating (1-5 stars) */}\n            <div className=\"mb-4 relative z-10\">\n              <label className=\"text-xs font-mono font-bold text-neutral-300 block mb-2 text-center uppercase\">\n                \302\277C\303\263mo te has sentido en esta sesi\303\263n?\n              </label>\n              <div className=\"flex justify-center gap-2\">\n                {[1, 2, 3, 4, 5].map((star) => (\n                  <button\n                    key={star}\n                    onClick={() => setRating(star)}\n                    className={`w-11 h-11 rounded-2xl text-lg font-bold transition-transform ${\n                      rating >= star\n                        ? \'bg-amber-400 text-neutral-950 scale-110 shadow-lg shadow-amber-400/20\'\n                        : \'bg-white/5 text-neutral-600 border border-white/5\'\n                    }`}\n                  >\n                    \342\230\205\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Notes textarea */}\n            <div className=\"mb-6 relative z-10\">\n              <input\n                type=\"text\"\n                value={notes}\n                onChange={(e) => setNotes(e.target.value)}\n                placeholder=\"Notas de la sesi\303\263n (ej. \'Excelente congesti\303\263n en banca...\')\"\n                className=\"w-full px-4 py-3 bg-white/5 border border-white/10 rounded-2xl text-xs text-white placeholder-neutral-500 focus:border-cyan-500 focus:outline-none\"\n              />\n            </div>\n\n            {/* Confirm & Save Button */}\n            <div className=\"flex gap-3 relative z-10\">\n              <button\n                onClick={() => setShowSummaryModal(false)}\n                className=\"flex-1 py-3 rounded-2xl bg-white/5 hover:bg-white/10 text-neutral-300 font-mono font-bold text-xs transition-colors border border-white/5\"\n              >\n                Volver a la Sesi\303\263n\n              </button>\n              <button\n                id=\"btn-confirm-save-workout\"\n                onClick={handleConfirmFinish}\n                className=\"flex-1 py-3 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-neutral-950 font-mono font-bold text-xs shadow-xl shadow-cyan-500/25 transition-transform hover:scale-105\"\n              >\n                Guardar y Reclamar XP\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
