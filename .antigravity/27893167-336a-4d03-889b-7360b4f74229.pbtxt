      replacement_content: "import {\n  UserProfile,\n  WorkoutRoutine,\n  CommunityChallenge,\n  Achievement,\n  LeaderboardUser,\n  SmartwatchDevice,\n  PushReminder,\n  WorkoutHistoryEntry,\n} from \'../types\';\n\nexport const initialUser: UserProfile = {\n  id: \'usr_me_01\',\n  name: \'Alex Rivera\',\n  avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\',\n  level: 14,\n  xp: 3450,\n  currentLevelXp: 450,\n  nextLevelXp: 1000,\n  rankTitle: \'Gladiador de \303\211lite\',\n  league: \'Gold\',\n  leaguePoints: 840,\n  stats: {\n    totalWorkouts: 48,\n    totalVolumeKg: 142850,\n    totalMinutes: 2180,\n    caloriesBurned: 24600,\n    currentStreak: 8,\n    bestStreak: 19,\n    duelsWon: 12,\n    challengesCompleted: 6,\n  },\n  attributes: {\n    strength: 78,\n    endurance: 72,\n    agility: 65,\n    discipline: 88,\n  },\n  unlockedBadges: [\'badge_first_pr\', \'badge_7_streak\', \'badge_titan_bench\', \'badge_iron_lungs\'],\n  joinedAt: \'2025-11-10\',\n  weightKg: 76.5,\n  targetWeightKg: 74.0,\n};\n\nexport const defaultRoutines: WorkoutRoutine[] = [\n  {\n    id: \'rt_upper_strength\',\n    title: \'Torso Fuerza & Sobrecarga\',\n    description: \'Rutina de fuerza enfocada en banca, remo con barra y press militar con descansos controlados.\',\n    category: \'Strength\',\n    difficulty: \'Advanced\',\n    durationMinutes: 55,\n    estimatedCalories: 480,\n    xpReward: 320,\n    targetMuscles: [\'Pectoral\', \'Espalda\', \'Hombros\', \'Tr\303\255ceps\'],\n    tags: [\'Fuerza\', \'Barra\', \'Sobrecarga\'],\n    exercises: [\n      {\n        id: \'ex_bench_press\',\n        name: \'Press de Banca Plano\',\n        muscleGroup: \'Chest\',\n        equipment: \'Barbell\',\n        restSeconds: 90,\n        prKg: 105,\n        instructions: \'Mant\303\251n los om\303\263platos retra\303\255dos, apoya los pies firmes y desciende la barra controlada al estern\303\263n.\',\n        tip: \'Empuja el suelo con los pies para activar el leg drive.\',\n        sets: [\n          { id: \'s1\', setNumber: 1, targetReps: 8, actualReps: 8, targetWeightKg: 80, actualWeightKg: 80, completed: false, isWarmup: true },\n          { id: \'s2\', setNumber: 2, targetReps: 6, actualReps: 6, targetWeightKg: 90, actualWeightKg: 90, completed: false },\n          { id: \'s3\', setNumber: 3, targetReps: 5, actualReps: 5, targetWeightKg: 95, actualWeightKg: 95, completed: false },\n          { id: \'s4\', setNumber: 4, targetReps: 4, actualReps: 4, targetWeightKg: 100, actualWeightKg: 100, completed: false },\n        ],\n      },\n      {\n        id: \'ex_barbell_row\',\n        name: \'Remo Pendlay con Barra\',\n        muscleGroup: \'Back\',\n        equipment: \'Barbell\',\n        restSeconds: 75,\n        prKg: 90,\n        instructions: \'Torso a 90 grados respecto al suelo, tira con los codos hacia la cadera contrayendo dorsales.\',\n        tip: \'No balancees el torso en la fase conc\303\251ntrica.\',\n        sets: [\n          { id: \'s5\', setNumber: 1, targetReps: 8, actualReps: 8, targetWeightKg: 70, actualWeightKg: 70, completed: false },\n          { id: \'s6\', setNumber: 2, targetReps: 8, actualReps: 8, targetWeightKg: 75, actualWeightKg: 75, completed: false },\n          { id: \'s7\', setNumber: 3, targetReps: 6, actualReps: 6, targetWeightKg: 80, actualWeightKg: 80, completed: false },\n        ],\n      },\n      {\n        id: \'ex_overhead_press\',\n        name: \'Press Militar de Pie (OHP)\',\n        muscleGroup: \'Shoulders\',\n        equipment: \'Barbell\',\n        restSeconds: 75,\n        prKg: 65,\n        instructions: \'Gl\303\272teos y abdomen contra\303\255dos. Empuja la barra por encima de la cabeza y mete la cabeza hacia adelante al bloquear.\',\n        tip: \'Bloquea el core para evitar hiperextender la zona lumbar.\',\n        sets: [\n          { id: \'s8\', setNumber: 1, targetReps: 8, actualReps: 8, targetWeightKg: 45, actualWeightKg: 45, completed: false },\n          { id: \'s9\', setNumber: 2, targetReps: 6, actualReps: 6, targetWeightKg: 52.5, actualWeightKg: 52.5, completed: false },\n          { id: \'s10\', setNumber: 3, targetReps: 6, actualReps: 6, targetWeightKg: 55, actualWeightKg: 55, completed: false },\n        ],\n      },\n      {\n        id: \'ex_dips\',\n        name: \'Fondos en Paralelas con Lastre\',\n        muscleGroup: \'Arms\',\n        equipment: \'Bodyweight\',\n        restSeconds: 60,\n        prKg: 25,\n        instructions: \'Incl\303\255nate ligeramente hacia adelante para mayor activaci\303\263n de pectoral o recto para tr\303\255ceps.\',\n        sets: [\n          { id: \'s11\', setNumber: 1, targetReps: 10, actualReps: 10, targetWeightKg: 10, actualWeightKg: 10, completed: false },\n          { id: \'s12\', setNumber: 2, targetReps: 8, actualReps: 8, targetWeightKg: 15, actualWeightKg: 15, completed: false },\n          { id: \'s13\', setNumber: 3, targetReps: 8, actualReps: 8, targetWeightKg: 15, actualWeightKg: 15, completed: false },\n        ],\n      },\n    ],\n  },\n  {\n    id: \'rt_legs_hypertrophy\',\n    title: \'Pierna & Gl\303\272teos Tit\303\241n\',\n    description: \'Enfoque en cu\303\241driceps, isquiosurales y gl\303\272teos para m\303\241xima hipertrofia y potencia atl\303\251tica.\',\n    category: \'Hypertrophy\',\n    difficulty: \'Advanced\',\n    durationMinutes: 60,\n    estimatedCalories: 560,\n    xpReward: 350,\n    targetMuscles: [\'Cu\303\241driceps\', \'Isquiotibiales\', \'Gl\303\272teos\', \'Gemelos\'],\n    tags: [\'Pierna\', \'Sentadilla\', \'Hipertrofia\'],\n    exercises: [\n      {\n        id: \'ex_squat\',\n        name: \'Sentadilla Trasera Profunda\',\n        muscleGroup: \'Legs\',\n        equipment: \'Barbell\',\n        restSeconds: 120,\n        prKg: 145,\n        instructions: \'Pies al ancho de hombros, rompe el paralelo manteniendo el pecho alto y la columna neutra.\',\n        tip: \'Inhala profundamente antes de desce